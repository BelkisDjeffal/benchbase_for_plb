    "    Prepares and plots heatmaps for Freemium, Premium, and Overall groups across specified strategies.\n",
    "    Each group is displayed as a separate row of heatmaps; each column is a different strategy.\n",
    "    \"\"\"\n",
    "    df_all = df_all.copy()\n",
    "\n",
    "    def prepare_client_counts(df, group, value_column):\n",
    "        df = df.copy()\n",
