    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def build_hybrid_comparison(df_overall, combo_pairs, target_strategies=[\"6RR\", \"5PLB\", \"5PLB2\", \"5RR\"]):\n",
    "    hybrid_rows = []\n",
    "    real_rows = []\n",
    "    seen_client_counts = set() \n",
    "\n",
    "    for (premium_strat, freemium_strat) in combo_pairs:\n",
    "        freemium_df = df_overall[\n",
    "            (df_overall[\"Strategy\"] == freemium_strat) & (df_overall[\"Source\"] == \"FreemiumOnly\")\n",
    "        ]\n",
    "        premium_df = df_overall[\n",
    "            (df_overall[\"Strategy\"] == premium_strat) & (df_overall[\"Source\"] == \"PremiumOnly\")\n",
    "        ]\n",
    "\n",
    "        for _, f_row in freemium_df.iterrows():\n",
    "            for _, p_row in premium_df.iterrows():\n",
    "                total_clients = p_row[\"ClientCount\"] + f_row[\"ClientCount\"]\n",
    "                \n",
    "                f_req = f_row[\"Measured Requests\"]\n",
    "                p_req = p_row[\"Measured Requests\"]\n",
    "                total_req = f_req + p_req\n",
    "                \n",
    "                hybrid_row = {\n",
    "                    \"Strategy\": f\"{premium_strat}+{freemium_strat}\",\n",
    "                    \"ClientCount\": total_clients,\n",
    "                    \"Group\": \"Overall\",\n",
    "                    \"Variant\": \"Hybrid\",\n",
    "                    \"Measured Requests\": total_req,\n",
    "                }\n",
    "\n",
    "                for stat in [\"Avg\", \"Median\", \"Max\", \"95th\"]:\n",
    "                    for cat in [\"Latency\", \"Throughput\", \"Goodput\"]:\n",
    "                        col = f\"{stat} {cat}\"\n",
    "                        val_f = f_row.get(col, np.nan)\n",
    "                        val_p = p_row.get(col, np.nan)\n",
    "                \n",
    "                        if np.isnan(val_f) or np.isnan(val_p):\n",
    "                            hybrid_row[col] = np.nan\n",
    "                            continue\n",
    "                \n",
    "                        if stat == \"Avg\":\n",
    "                            # Weighted average\n",
    "                            hybrid_row[col] = (f_req * val_f + p_req * val_p) / total_req\n",
    "                        elif stat == \"Max\":\n",
    "                            hybrid_row[col] = max(val_f, val_p)\n",
    "                        elif stat == \"Median\" or stat == \"95th\":\n",
    "                            # Choose the value from the group with more queries (approximation)\n",
    "                            hybrid_row[col] = val_f if f_req >= p_req else val_p\n",
    "\n",
    "                hybrid_rows.append(hybrid_row)\n",
    "\n",
    "                # Add matching real strategy rows (once per client count)\n",
    "                if total_clients not in seen_client_counts:\n",
    "                    seen_client_counts.add(total_clients)\n",
    "                    for real_strat in target_strategies:\n",
    "                        match = df_overall[\n",
    "                            (df_overall[\"Strategy\"] == real_strat) &\n",
    "                            (df_overall[\"ClientCount\"] == total_clients) &\n",
    "                            (df_overall[\"Variant\"] == \"All\")\n",
    "                        ]\n",
    "                        real_rows.extend(match.to_dict(orient=\"records\"))\n",
    "\n",
    "    return pd.DataFrame(hybrid_rows), pd.DataFrame(real_rows)\n",
    "    \n",
    "def summarize_hybrid_df(df_hybrid, metric=\"Latency\"):\n",
    "    summaries = []\n",
    "    grouped = df_hybrid.groupby([\"Strategy\", \"ClientCount\"])\n",
    "\n",
    "    for (strategy, client_count), group in grouped:\n",
    "        summary = {\n",
    "            \"Strategy\": strategy,\n",
    "            \"ClientCount\": client_count,\n",
    "            \"Group\": \"Overall\",\n",
    "            \"Variant\": \"Hybrid\",\n",
    "        }\n",
    "\n",
    "        # --- Weighted Avg\n",
    "        if f\"Avg {metric}\" in group and \"Measured Requests\" in group:\n",
    "            avg_vals = group[[f\"Avg {metric}\", \"Measured Requests\"]].dropna()\n",
    "            if not avg_vals.empty:\n",
    "                total_req = avg_vals[\"Measured Requests\"].sum()\n",
    "                weighted_avg = np.average(\n",
    "                    avg_vals[f\"Avg {metric}\"],\n",
    "                    weights=avg_vals[\"Measured Requests\"]\n",
    "                )\n",
    "                summary[\"Measured Requests\"] = total_req\n",
    "                summary[f\"Avg {metric}\"] = weighted_avg\n",
    "\n",
    "        # --- Max\n",
    "        if f\"Max {metric}\" in group:\n",
    "            max_vals = group[f\"Max {metric}\"].dropna()\n",
    "            summary[f\"Max {metric}\"] = max_vals.max() if not max_vals.empty else np.nan\n",
    "\n",
    "        # --- 95th\n",
    "        if f\"95th {metric}\" in group:\n",
    "            perc95_vals = group[f\"95th {metric}\"].dropna()\n",
    "            summary[f\"95th {metric}\"] = np.percentile(perc95_vals, 95) if not perc95_vals.empty else np.nan\n",
    "\n",
    "        # --- Median\n",
    "        if f\"Median {metric}\" in group:\n",
    "            median_vals = group[f\"Median {metric}\"].dropna()\n",
    "            summary[f\"Median {metric}\"] = np.median(median_vals) if not median_vals.empty else np.nan\n",
    "\n",
    "        summaries.append(summary)\n",
    "\n",
    "    return pd.DataFrame(summaries)\n",
    "\n",
    "\n",
    "def plot_hybrid_comparison(df_real, df_hybrid_summary, metric=\"Latency\", stat=\"Avg\"):\n",
    "    col = f\"{stat} {metric}\"\n",
    "\n",
    "    df_real = df_real.copy()\n",
    "    #df_real = df_real.drop_duplicates(subset=[\"Strategy\", \"ClientCount\"])\n",
    "    df_real[\"Variant\"] = \"All\"\n",
    "    df_real[\"Group\"] = \"Overall\"\n",
    "\n",
    "    hybrid_counts = set(df_hybrid_summary[\"ClientCount\"].unique())\n",
    "    hybrid_counts = set(df_real[\"ClientCount\"].unique())\n",
    "    shared_counts = hybrid_counts & hybrid_counts\n",
    "\n",
    "    df_hybrid_summary = df_hybrid_summary[df_hybrid_summary[\"ClientCount\"].isin(shared_counts)].copy()\n",
    "    df_real = df_real[df_real[\"ClientCount\"].isin(shared_counts)].copy()\n",
    "    \n",
    "    keep_cols = [\"Strategy\", \"ClientCount\", \"Group\", \"Variant\", col]\n",
    "\n",
    "    df_plot = pd.concat([\n",
    "        df_real[keep_cols],\n",
    "        df_hybrid_summary[keep_cols]\n",
    "    ], ignore_index=True)\n",
    "\n",
    "    # Sort x-axis\n",
    "    terminals_order = sorted(df_plot[\"ClientCount\"].unique())\n",
    "    df_plot[\"ClientCount_str\"] = pd.Categorical(\n",
    "        df_plot[\"ClientCount\"].astype(str),\n",
    "        categories=[str(t) for t in terminals_order],\n",
    "        ordered=True\n",
    "    )\n",
    "\n",
    "    # Sort legend\n",
    "    strategy_order = sorted(df_plot[\"Strategy\"].unique())\n",
    "    df_plot[\"Strategy\"] = pd.Categorical(\n",
    "        df_plot[\"Strategy\"],\n",
    "        categories=strategy_order,\n",
    "        ordered=True\n",
    "    )\n",
    "\n",
    "    plt.figure(figsize=(14, 6))\n",
    "    sns.lineplot(\n",
    "        data=df_plot,\n",
    "        x=\"ClientCount_str\", y=col,\n",
    "        hue=\"Strategy\", marker=\"o\", linewidth=2\n",
    "    )\n",
    "    plt.title(f\"Overall {metric} ({stat}) - Hybrid vs Mixed Strategies\")\n",
    "    plt.xlabel(\"Total Clients_str\")\n",
    "    plt.ylabel(f\"{metric} ({stat})\")\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.grid(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "combo_pairs = [(\"4RR\", \"1RR\"), (\"3RR\", \"2RR\"), (\"4RR\", \"3RR\"), (\"4RR\", \"2RR\")]\n",
    "\n",
    "# Build\n",
    "hybrid_df, matching_real_df = build_hybrid_comparison(df_overall, combo_pairs)\n",
    "\n",
    "hybrid_df.to_csv(f\"{output_path}/hybrid_df.csv\", index=False)\n",
    "matching_real_df.to_csv(f\"{output_path}/matching_real_df.csv\", index=False)\n",
    "\n",
    "\n",
    "hybrid_summary_latency = summarize_hybrid_df(hybrid_df, metric=\"Latency\")\n",
    "hybrid_summary_throughput = summarize_hybrid_df(hybrid_df, metric=\"Throughput\")\n",
    "\n",
    "\n",
    "# Plot\n",
    "plot_hybrid_comparison(matching_real_df, hybrid_summary_latency, metric=\"Latency\", stat=\"Avg\")\n",
    "plot_hybrid_comparison(matching_real_df, hybrid_summary_latency, metric=\"Latency\", stat=\"95th\")\n",
    "#plot_hybrid_comparison(matching_real_df, hybrid_summary_latency, metric=\"Latency\", stat=\"Median\")\n",
    "\n",
    "plot_hybrid_comparison(matching_real_df, hybrid_summary_throughput, metric=\"Throughput\", stat=\"Avg\")\n",
    "plot_hybrid_comparison(matching_real_df, hybrid_summary_throughput, metric=\"Throughput\", stat=\"95th\")\n"
   ]
