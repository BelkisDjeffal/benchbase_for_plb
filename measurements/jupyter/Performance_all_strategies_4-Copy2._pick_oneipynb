    "def detailed_comparison_dfs(df_all):\n",
    "    freemium_only_strategies = [\"1RR\", \"2RR\", \"3RR\",\"4RR\"]\n",
    "    premium_only_strategies = [\"1RR\", \"2RR\", \"3RR\",\"4RR\"]\n",
    "    mixed_strategies = [\"6RR\", \"5PLB\", \"5PLB2\", \"5RR\"]\n",
    "\n",
    "    freemium_rows, premium_rows, overall_rows = [], [], []\n",
    "\n",
    "    metrics = [\"Avg\", \"Max\", \"Stddev\", \"95th\", \"Median\"]\n",
    "    categories = [\"Latency\", \"Throughput\", \"Goodput\"]\n",
    "\n",
    "    for _, row in df_all.iterrows():\n",
    "        strat = row[\"Strategy\"]\n",
    "\n",
    "        def collect_metrics(prefix, client_count, strat, source_label):\n",
    "            rec = {\"Strategy\": strat, \"ClientCount\": client_count, \"Group\": prefix, \"Source\": source_label,  \"Measured Requests\": row[\"Measured Requests\"]}\n",
    "            for m in metrics:\n",
    "                for cat in categories:\n",
    "                    col = f\"{prefix} {m} {cat}\"\n",
    "                    rec[f\"{m} {cat}\"] = row.get(col, None)\n",
    "            return rec\n",
    "\n",
    "        if strat in freemium_only_strategies:\n",
    "            freemium_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"FreemiumOnly\"))\n",
    "            overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"FreemiumOnly\"))\n",
    "\n",
    "        if strat in premium_only_strategies:\n",
    "            premium_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"PremiumOnly\"))\n",
    "            overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"PremiumOnly\"))\n",
    "            \n",
    "        elif strat in mixed_strategies:\n",
    "            source_label = \"Mixed\"\n",
    "\n",
    "            if \"PLB\" in strat and row[\"PremiumClients\"] > row[\"FreemiumClients\"]:\n",
    "                source_label = \"PLB_P>F\"\n",
    "\n",
    "            if row.get(\"FreemiumClients\", 0) > 0:\n",
    "                freemium_rows.append(collect_metrics(\"Freemium\", row[\"FreemiumClients\"], strat, source_label))\n",
    "\n",
    "            if row.get(\"PremiumClients\", 0) > 0:\n",
    "                premium_rows.append(collect_metrics(\"Premium\", row[\"PremiumClients\"], strat, source_label))\n",
    "\n",
    "            overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, source_label))\n",
    "\n",
    "    df_freemium = pd.DataFrame(freemium_rows)\n",
    "    df_premium = pd.DataFrame(premium_rows)\n",
    "    df_overall = pd.DataFrame(overall_rows)\n",
    "\n",
    "    return df_freemium, df_premium, df_overall\n",
    "df_freemium, df_premium, df_overall = detailed_comparison_dfs(df_all)\n",
    "df_premium[df_premium[\"Source\"] == \"PLB_P>F\"]\n",
    "df_freemium[df_freemium[\"Source\"] == \"PLB_P>F\"]\n",
    "\n",
    "\n",
    "#display(df_premium)\n",
    "#display(df_freemium)\n",
    "df_all[df_all[\"Strategy\"].str.contains(\"RR\") & (df_all[\"PremiumClients\"] > df_all[\"FreemiumClients\"])]\n",
    "\n",
    "df_freemium.to_csv(f\"{output_path}/comparison_freemium.csv\", index=False)\n",
    "df_premium.to_csv(f\"{output_path}/comparison_premium.csv\", index=False)\n",
    "df_overall.to_csv(f\"{output_path}/comparison_oversummary_results.csv\", index=False)"
   ]
