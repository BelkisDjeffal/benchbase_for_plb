    "            df_sub = df_plot[(df_plot[\"Group\"] == group) & (df_plot[\"Strategy\"] == strategy)]\n",
    "\n",
    "            if df_sub.empty:\n",
    "                ax.axis(\"off\")\n",
    "                ax.set_title(f\"{strategy} ({group})\\n[No Data]\")\n",
    "                continue\n",
    "\n",
    "            pivot = df_sub.pivot_table(\n",
    "                index=\"FreemiumClients\", columns=\"PremiumClients\", values=\"Avg Latency\", aggfunc=\"mean\"\n",
    "            ).sort_index(ascending=True)\n",
    "\n",
    "            sns.heatmap(pivot, annot=True, fmt=\".1f\", cmap=\"coolwarm\", cbar=(j == n_cols - 1), ax=ax)\n",
