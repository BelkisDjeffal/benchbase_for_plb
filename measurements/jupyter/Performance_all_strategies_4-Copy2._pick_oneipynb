    "                            \"Percent change\": f\"{((mean_test - mean_base) / mean_base) * 100:+.2f}%\",\n",
    "                            \"t-stat\": round(t_stat, 4),\n",
    "                            \"p-value\": f\"{p_val:.2e}\",\n",
    "                            \"Cohen's d\": round(d, 4),\n",
    "                            \"Direction\": direction\n",
    "                        })\n",
    "                    except Exception:\n",
    "                        continue\n",
    "\n",
    "    return pd.DataFrame(results)\n",
