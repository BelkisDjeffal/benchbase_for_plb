    "            df[\"PremiumClients\"] = df[\"Terminals\"]\n",
    "            df[\"FreemiumClients\"] = 0\n",
    "        return df[[\"Strategy\", \"PremiumClients\", \"FreemiumClients\", \"Avg Latency\", \"Group\"]]\n",
    "\n",
    "    df_freemium = prepare_client_counts(df_all, \"Freemium\", f\"Freemium {metric_column_prefix}\")\n",
    "    df_premium = prepare_client_counts(df_all, \"Premium\", f\"Premium {metric_column_prefix}\")\n",
    "    df_overall = prepare_client_counts(df_all, \"Overall\", f\"Overall {metric_column_prefix}\")\n",
    "    df_plot = pd.concat([df_freemium, df_premium, df_overall], ignore_index=True)\n",
    "\n",
    "    # Start plotting\n",
    "    groups = [\"Freemium\", \"Premium\", \"Overall\"]\n",
    "    n_rows = len(groups)\n",
    "    n_cols = len(strategies)\n",
    "\n",
    "    fig, axes = plt.subplots(nrows=n_rows, ncols=n_cols, figsize=(4 * n_cols, 4 * n_rows), squeeze=False)\n",
    "\n",
    "    for i, group in enumerate(groups):\n",
    "        for j, strategy in enumerate(strategies):\n",
