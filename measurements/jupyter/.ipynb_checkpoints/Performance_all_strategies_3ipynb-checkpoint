    "def detailed_comparison_dfs2(df_all):\n",
    "    freemium_only_strategies = [\"1RR\", \"2RR\", \"3RR\",\"4RR\"]\n",
    "    premium_only_strategies = [\"1RR\", \"2RR\", \"3RR\",\"4RR\"]\n",
    "    mixed_strategies = [\"5RR\", \"5PLB\", \"5PLB2\", \"6PLB\"]\n",
    "\n",
    "    freemium_rows, premium_rows, overall_rows = [], [], []\n",
    "\n",
    "    metrics = [\"Avg\", \"Max\", \"Stddev\", \"95th\", \"Median\"]\n",
    "    categories = [\"Latency\", \"Throughput\", \"Goodput\"]\n",
    "\n",
    "    for _, row in df_all.iterrows():\n",
    "        strat = row[\"Strategy\"]\n",
    "\n",
    "        def collect_metrics(prefix, client_count, strat, source_label, variant_label=None):\n",
    "            rec = {\n",
    "                \"Strategy\": strat,\n",
    "                \"ClientCount\": client_count,\n",
    "                \"Group\": prefix,\n",
    "                \"Source\": source_label,\n",
    "                \"Variant\": variant_label or source_label,\n",
    "                \"Measured Requests\": row[\"Measured Requests\"]\n",
    "            }\n",
    "            for m in metrics:\n",
    "                for cat in categories:\n",
    "                    col = f\"{prefix} {m} {cat}\"\n",
    "                    rec[f\"{m} {cat}\"] = row.get(col, None)\n",
    "            return rec\n",
    "\n",
    "\n",
    "        if strat in freemium_only_strategies:\n",
    "            freemium_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"FreemiumOnly\", \"All\"))\n",
    "            overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"FreemiumOnly\", \"All\"))\n",
    "\n",
    "        if strat in premium_only_strategies:\n",
    "            premium_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"PremiumOnly\", \"All\"))\n",
    "            overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, \"PremiumOnly\", \"All\"))\n",
    "            \n",
    "        elif strat in mixed_strategies:\n",
    "            source_label = \"Mixed\"\n",
    "\n",
    "            pc = row.get(\"PremiumClients\", 0)\n",
    "            fc = row.get(\"FreemiumClients\", 0)\n",
    "\n",
    "            if \"PLB\" in strat:\n",
    "                # Determine variant\n",
    "                if pc > fc:\n",
    "                    variant = \"PLB_P>F\"\n",
    "                elif pc < fc:\n",
    "                    variant = \"PLB_P<F\"\n",
    "                else:\n",
    "                    variant = \"PLB_P=F\"\n",
    "\n",
    "                if fc > 0:\n",
    "                    freemium_rows.append(collect_metrics(\"Freemium\", fc, strat, source_label, variant))\n",
    "                if pc > 0:\n",
    "                    premium_rows.append(collect_metrics(\"Premium\", pc, strat, source_label, variant))\n",
    "                overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, source_label, variant))\n",
    "\n",
    "                # Duplicate to \"All\"\n",
    "                if fc > 0:\n",
    "                    freemium_rows.append(collect_metrics(\"Freemium\", fc, strat, source_label, \"All\"))\n",
    "                if pc > 0:\n",
    "                    premium_rows.append(collect_metrics(\"Premium\", pc, strat, source_label, \"All\"))\n",
    "                overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, source_label, \"All\"))\n",
    "\n",
    "            else:\n",
    "                for variant in [\"All\", \"PLB_P>F\", \"PLB_P=F\", \"PLB_P<F\"]:\n",
    "                    if fc > 0:\n",
    "                        freemium_rows.append(collect_metrics(\"Freemium\", fc, strat, source_label, variant))\n",
    "                    if pc > 0:\n",
    "                        premium_rows.append(collect_metrics(\"Premium\", pc, strat, source_label, variant))\n",
    "                    overall_rows.append(collect_metrics(\"Overall\", row[\"Terminals\"], strat, source_label, variant))\n",
    "\n",
    "            \n",
    "\n",
    "\n",
    "    df_freemium = pd.DataFrame(freemium_rows)\n",
    "    df_premium = pd.DataFrame(premium_rows)\n",
    "    df_overall = pd.DataFrame(overall_rows)\n",
    "\n",
    "    return df_freemium, df_premium, df_overall\n",
    "\n",
    "df_freemium, df_premium, df_overall = detailed_comparison_dfs2(df_all)\n",
    "#df_premium[df_premium[\"Source\"] == \"PLB_P>F\"]\n",
    "#df_freemium[df_freemium[\"Source\"] == \"PLB_P>F\"]\n",
    "\n",
    "\n",
    "#display(df_premium)\n",
    "#display(df_freemium)\n",
    "df_freemium.to_csv(f\"{output_path}/comparison_freemium.csv\", index=False)\n",
    "df_premium.to_csv(f\"{output_path}/comparison_premium.csv\", index=False)\n",
    "df_overall.to_csv(f\"{output_path}/comparison_overall.csv\", index=False)\n",
    "\n",
    "def plot_facet_by_variant(df, metric=\"Latency\", stat=\"Avg\", title_prefix=\"Freemium\"):\n",
    "    col = f\"{stat} {metric}\"\n",
    "    df = df.copy()\n",
    "\n",
    "    df[\"ClientCount_str\"] = pd.Categorical(\n",
    "        df[\"ClientCount\"].astype(str),\n",
    "        categories=[str(x) for x in sorted(df[\"ClientCount\"].unique())],\n",
    "        ordered=True\n",
    "    )\n",
    "\n",
    "    df[\"IsPLB\"] = df[\"Strategy\"].str.contains(\"PLB\")\n",
    "\n",
    "    variant_values = [\"All\", \"PLB_P>F\", \"PLB_P=F\", \"PLB_P<F\"]\n",
    "    df[\"Variant\"] = pd.Categorical(df[\"Variant\"], categories=variant_values, ordered=True)\n",
    "\n",
    "    g = sns.FacetGrid(df, col=\"Variant\", col_wrap=3, height=5, sharey=True, sharex=True)\n",
    "\n",
    "    def custom_lineplot(data, color, **kwargs):\n",
    "        facet_variant = data[\"Variant\"].iloc[0]\n",
    "        group = data[\"Group\"].iloc[0]\n",
    "    \n",
    "        base = df[\n",
    "            (~df[\"IsPLB\"]) \n",
    "        ]\n",
    "    \n",
    "        if facet_variant == \"All\":\n",
    "            plb = df[\n",
    "                (df[\"IsPLB\"]) &\n",
    "                (df[\"Group\"] == group) &\n",
    "                (df[\"Variant\"] == \"All\")\n",
    "\n",
    "            ]\n",
    "        else:\n",
    "            plb = df[\n",
    "                (df[\"IsPLB\"]) &\n",
    "                (df[\"Group\"] == group) &\n",
    "                (df[\"Variant\"] == facet_variant)\n",
    "            ]\n",
    "    \n",
    "        subset = pd.concat([base, plb], ignore_index=True)\n",
    "    \n",
    "        sns.lineplot(\n",
    "            data=subset,\n",
    "            x=\"ClientCount_str\", y=col,\n",
    "            hue=\"Strategy\", errorbar=\"sd\", marker=\"o\",\n",
    "            linewidth=2, alpha=0.85, **kwargs\n",
    "        )\n",
    "\n",
    "    g.map_dataframe(custom_lineplot)\n",
    "\n",
    "    for ax in g.axes.flat:\n",
    "        for label in ax.get_xticklabels():\n",
    "            label.set_rotation(45)\n",
    "            label.set_ha('right')\n",
    "\n",
    "    g.set_titles(\"{col_name}\")\n",
    "    g.set_axis_labels(f\"{title_prefix} Client Count\", f\"{metric} ({stat})\")\n",
    "    g.add_legend()\n",
    "    plt.tight_layout()\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "    \n",
    "plot_facet_by_variant(df_freemium, metric=\"Latency\", stat=\"Avg\", title_prefix=\"Freemium\")\n",
    "plot_facet_by_variant(df_premium, metric=\"Latency\", stat=\"Avg\", title_prefix=\"Premium\")\n",
    "plot_facet_by_variant(df_overall, metric=\"Latency\", stat=\"Avg\", title_prefix=\"Overall\")\n",
    "\n"
   ]
