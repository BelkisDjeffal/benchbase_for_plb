    "def prepare_client_counts(df, group, value_column):\n",
    "    df = df.copy()\n",
    "    df[\"Group\"] = group\n",
    "    df[\"Avg Latency\"] = df[value_column]\n",
    "    if group == \"Freemium\":\n",
    "        df[\"FreemiumClients\"] = df[\"Terminals\"]\n",
    "        df[\"PremiumClients\"] = 0\n",
    "    elif group == \"Premium\":\n",
    "        df[\"PremiumClients\"] = df[\"Terminals\"]\n",
    "        df[\"FreemiumClients\"] = 0\n",
    "    return df[[\"Strategy\", \"Terminals\", \"PremiumClients\", \"FreemiumClients\", \"Avg Latency\", \"Group\"]]\n",
    "\n",
    "df_freemium_plot = prepare_client_counts(df_all, \"Freemium\", \"Freemium Avg Latency\")\n",
    "df_premium_plot = prepare_client_counts(df_all, \"Premium\", \"Premium Avg Latency\")\n",
    "df_overall_plot = prepare_client_counts(df_all, \"Overall\", \"Overall Avg Latency\")\n",
    "\n",
    "df_combined_plot = pd.concat([df_freemium_plot, df_premium_plot, df_overall_plot], ignore_index=True)\n",
    "\n",
    "def plot_latency_by_client_mix(df, value_col=\"Avg Latency\"):\n",
    "    df[\"FreemiumClients_str\"] = df[\"FreemiumClients\"].astype(str)\n",
    "    terminals_order = sorted(df[\"FreemiumClients\"].unique())\n",
    "    df[\"FreemiumClients_str\"] = pd.Categorical(df[\"FreemiumClients_str\"], \n",
    "                                        categories=[str(t) for t in terminals_order], \n",
    "                                        ordered=True)\n",
    "    df[\"PremiumClients_str\"] = df[\"PremiumClients\"].astype(str)\n",
    "    terminals_order = sorted(df[\"PremiumClients\"].unique())\n",
    "    df[\"PremiumClients_str\"] = pd.Categorical(df[\"PremiumClients_str\"], \n",
    "                                        categories=[str(t) for t in terminals_order], \n",
    "                                        ordered=True)\n",
    "    g = sns.relplot(\n",
    "        data=df,\n",
