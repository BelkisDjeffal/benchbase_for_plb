    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def assign_style(row):\n",
    "    return \"PLB_P>F\" if row[\"Source\"] == \"PLB_P>F\" else \"Other\"\n",
    "    \n",
    "def plot_comparison_with_shaded_std(df, metric=\"Latency\", stat=\"Avg\", title_prefix=\"Freemium\"):\n",
    "    col = f\"{stat} {metric}\"\n",
    "    df[\"ClientCount_str\"] = df[\"ClientCount\"].astype(str)\n",
    "    terminals_order = sorted(df[\"ClientCount\"].unique())\n",
    "    df[\"ClientCount_str\"] = pd.Categorical(df[\"ClientCount_str\"], \n",
    "                                        categories=[str(t) for t in terminals_order], \n",
    "                                        ordered=True)\n",
    "    \n",
    "    df[\"StyleLabel\"] = df[\"Source\"].apply(lambda x: \"PLB_P>F\" if x == \"PLB_P>F\" else \"Other\")\n",
    "    plt.figure(figsize=(14, 7))\n",
    "    sns.lineplot(\n",
    "        data=df,\n",
    "        x=\"ClientCount_str\",\n",
    "        y=col,\n",
    "        hue=\"Strategy\",        \n",
    "        #style=\"StyleLabel\",        \n",
    "        #markers=True,           \n",
    "        #dashes=True,           \n",
    "        errorbar=\"sd\",\n",
    "        marker=\"o\",\n",
    "        linewidth=2,\n",
    "        alpha=0.85\n",
    "    )\n",
    "\n",
    "    plt.title(f\"{title_prefix} {metric} {stat} ± std across runs\")\n",
    "    plt.xlabel(f\"{title_prefix} Client Count\")\n",
    "    plt.ylabel(f\"{metric} ({stat})\")\n",
    "    plt.grid(True)\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.tight_layout()\n",
