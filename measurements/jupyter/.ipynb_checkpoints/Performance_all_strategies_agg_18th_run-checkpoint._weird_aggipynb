    "                    record[\"Metric\"] = row[f\"Overall {value_column}\"]\n",
    "                elif strat in mixed_strats and row[\"PremiumClients\"] > 0:\n",
    "                    record[\"PremiumClients\"] = row[\"PremiumClients\"]\n",
    "                    record[\"FreemiumClients\"] = 0\n",
    "                    record[\"Metric\"] = row[f\"Premium {value_column}\"]\n",
    "                else:\n",
    "                    continue\n",
    "\n",
    "            elif group == \"Overall\":\n",
    "                record[\"PremiumClients\"] = row[\"PremiumClients\"]\n",
    "                record[\"FreemiumClients\"] = row[\"FreemiumClients\"]\n",
    "                record[\"Metric\"] = row[f\"Overall {value_column}\"]\n",
