    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "def relaxed_welch_plb_vs_rr_balanced(df_all: pd.DataFrame, metrics: list, baseline_strategy=\"RR\", plb_strategy=\"PLB\") -> pd.DataFrame:\n",
    "\n",
    "    results = []\n",
    "\n",
    "    plb_rows = df_all[df_all[\"Strategy\"] == plb_strategy]\n",
    "    rr_rows = df_all[df_all[\"Strategy\"] == baseline_strategy]\n",
    "\n",
    "    for term in sorted(plb_rows[\"Terminals\"].unique()):\n",
    "        df_base = rr_rows[rr_rows[\"Terminals\"] == term]\n",
    "        df_test_group = plb_rows[plb_rows[\"Terminals\"] == term]\n",
    "\n",
    "        if df_base.empty or df_test_group.empty:\n",
    "            continue\n",
    "\n",
    "        # Optional: distinguish by ratio label for PLB\n",
    "        df_test_group = df_test_group.copy()\n",
    "        df_test_group[\"Ratio Label\"] = df_test_group.apply(\n",
    "            lambda row: f\"{int(row['PremiumClients'])}:{int(row['FreemiumClients'])}\", axis=1\n",
    "        )\n",
    "\n",
    "        for ratio, df_test in df_test_group.groupby(\"Ratio Label\"):\n",
    "            for metric in metrics:\n",
    "                try:\n",
    "                    base_vals = df_base[metric].dropna()\n",
    "                    test_vals = df_test[metric].dropna()\n",
    "\n",
    "                    if base_vals.empty or test_vals.empty:\n",
    "                        continue\n",
    "\n",
    "                    t_stat, p_val = ttest_ind(test_vals, base_vals, equal_var=False)\n",
    "\n",
    "                    mean_test = test_vals.mean()\n",
    "                    mean_base = base_vals.mean()\n",
    "\n",
    "                    nx, ny = len(test_vals), len(base_vals)\n",
    "                    pooled_std = np.sqrt(((nx - 1) * test_vals.var(ddof=1) + (ny - 1) * base_vals.var(ddof=1)) / (nx + ny - 2))\n",
    "                    d = (mean_test - mean_base) / pooled_std if pooled_std > 0 else 0\n",
    "\n",
    "                    if p_val < 0.001:\n",
    "                        p_comment = \"*** p < 0.001\"\n",
    "                    elif p_val < 0.01:\n",
    "                        p_comment = \"** p < 0.01\"\n",
    "                    elif p_val < 0.05:\n",
    "                        p_comment = \"* p < 0.05\"\n",
    "                    elif p_val < 0.1:\n",
    "                        p_comment = \". p < 0.1\"\n",
    "                    else:\n",
    "                        p_comment = \"ns\"\n",
    "\n",
    "                    if abs(d) < 0.2:\n",
    "                        magnitude = \"negligible\"\n",
    "                    elif abs(d) < 0.5:\n",
    "                        magnitude = \"small\"\n",
    "                    elif abs(d) < 0.8:\n",
    "                        magnitude = \"medium\"\n",
    "                    else:\n",
    "                        magnitude = \"large\"\n",
    "\n",
    "                    direction = \"improves\" if (\n",
    "                        (\"Latency\" in metric and mean_test < mean_base) or \n",
    "                        (\"Throughput\" in metric and mean_test > mean_base) or\n",
    "                        (\"Goodput\" in metric and mean_test > mean_base)\n",
    "                    ) else \"degrades\"\n",
    "\n",
    "                    results.append({\n",
    "                        \"Terminals\": term,\n",
    "                        \"Ratio\": ratio,\n",
    "                        \"Metric\": metric,\n",
    "                        \"Test mean\": round(mean_test, 4),\n",
    "                        \"Baseline mean\": round(mean_base, 4),\n",
    "                        \"Percent change\": f\"{((mean_test - mean_base) / mean_base) * 100:+.2f}%\",\n",
    "                        \"t-stat\": round(t_stat, 4),\n",
    "                        \"p-value\": f\"{p_val:.2e}\",\n",
    "                        \"Significance\": p_comment,\n",
    "                        \"Cohen's d\": round(d, 4),\n",
    "                        \"Effect size\": magnitude,\n",
    "                        \"Direction\": direction\n",
    "                    })\n",
    "                except Exception as e:\n",
    "                    results.append({\n",
    "                        \"Terminals\": term,\n",
    "                        \"Ratio\": ratio,\n",
    "                        \"Metric\": metric,\n",
    "                        \"Error\": str(e)\n",
    "                    })\n",
    "\n",
    "    return pd.DataFrame(results)\n"
