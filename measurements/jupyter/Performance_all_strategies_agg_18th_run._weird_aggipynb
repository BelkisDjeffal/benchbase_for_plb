    "def plot_overall_latency_per_strategy(df_all, strategies, value_column=\"Avg Latency\"):\n",
    "    fig, axes = plt.subplots(nrows=1, ncols=len(strategies), figsize=(4 * len(strategies), 5), constrained_layout=True)\n",
    "\n",
    "    if len(strategies) == 1:\n",
    "        axes = [axes]\n",
    "\n",
    "    for i, strat in enumerate(strategies):\n",
    "        df = df_all[df_all[\"Strategy\"] == strat].copy()\n",
    "        grouped = df.groupby([\"PremiumClients\", \"FreemiumClients\"])[f\"Overall {value_column}\"].mean().reset_index()\n",
    "        pivot = grouped.pivot(index=\"FreemiumClients\", columns=\"PremiumClients\", values=f\"Overall {value_column}\")\n",
    "        pivot = pivot.sort_index(ascending=True)\n",
    "        \n",
    "        sns.heatmap(pivot, annot=True, fmt=\".1f\", cmap=\"crest\",annot_kws={'size': 7, 'color': 'black', 'clip_on': False}, cbar=i == len(strategies) - 1, ax=axes[i])\n",
    "        axes[i].set_title(strat)\n",
    "        axes[i].set_xlabel(\"Premium Clients\")\n",
    "        axes[i].set_ylabel(\"Freemium Clients\")\n",
    "        axes[i].tick_params(axis='x', rotation=90)\n",
    "        axes[i].tick_params(axis='y', rotation=0)\n",
    "        axes[i].invert_yaxis()\n",
    "\n",
    "    plt.suptitle(f\"Overall {value_column} per Strategy\", fontsize=16)\n",
    "    plt.show()\n",
    "plot_overall_latency_per_strategy(df_all, strategies=[\"5PLB\", \"5RR\", \"4P\", \"3F\"], value_column=\"Avg Latency\")"
   ]
  },
