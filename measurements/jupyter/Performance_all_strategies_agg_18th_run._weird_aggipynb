    "import matplotlib.pyplot as plt\n",
    "\n",
    "def classify_balance(premium, freemium):\n",
    "    if premium > freemium:\n",
    "        return \"Premium-skewed\"\n",
    "    elif premium < freemium:\n",
    "        return \"Freemium-skewed\"\n",
    "    else:\n",
    "        return \"Balanced\"\n",
    "\n",
    "def plot_relaxed_welch_results(\n",
    "    df_result,\n",
    "    selected_metrics_dict,\n",
    "    labels=(\"Premium\", \"Freemium\", \"Overall\")\n",
    "):\n",
    "    \"\"\"\n",
    "    Plot Welch test results (Strategy vs RR), using:\n",
    "    - Color for metric family (Latency, Throughput, Goodput)\n",
    "    - Line style for strategy (solid/dashed)\n",
    "    \"\"\"\n",
    "    df_result = df_result.copy()\n",
    "    df_result[[\"Premium\", \"Freemium\"]] = df_result[\"Ratio\"].str.split(\":\", expand=True).astype(int)\n",
    "    df_result[\"Balance Type\"] = df_result.apply(\n",
    "        lambda row: classify_balance(row[\"Premium\"], row[\"Freemium\"]), axis=1\n",
    "    )\n",
    "\n",
    "    # Settings\n",
    "    balance_order = [\"Premium-skewed\", \"Balanced\", \"Freemium-skewed\"]\n",
    "    family_colors = {\n",
    "        \"Latency\": \"red\",\n",
    "        \"Throughput\": \"green\",\n",
    "        \"Goodput\": \"blue\"\n",
    "    }\n",
    "    aggregation_linestyles = {\n",
    "        \"Avg\": \"solid\",\n",
    "        \"Stddev\": \"dashed\",\n",
    "        \"95th\": (0, (3, 2, 1, 2))\n",
    "    }\n",
    "\n",
    "    def parse_metric_type(metric_label):\n",
    "        for agg in aggregation_linestyles:\n",
    "            if agg in metric_label:\n",
    "                if \"Latency\" in metric_label:\n",
    "                    return \"Latency\", agg\n",
    "                elif \"Throughput\" in metric_label:\n",
    "                    return \"Throughput\", agg\n",
    "                elif \"Goodput\" in metric_label:\n",
    "                    return \"Goodput\", agg\n",
    "        return \"Other\", \"Other\"\n",
    "\n",
    "    def determine_alpha(p):\n",
    "        if p < 0.001:\n",
    "            return 1.0\n",
    "        elif p < 0.05:\n",
    "            return 0.85\n",
    "        elif p < 0.1:\n",
    "            return 0.5\n",
    "        else:\n",
    "            return 0.25\n",
    "\n",
    "    # Get unique strategies and assign line styles\n",
    "    strategies = sorted(df_result[\"Compared Strategy\"].unique())\n",
    "    strategy_linestyles = {\n",
    "        strategy: \"solid\" if i % 2 == 0 else \"dashed\"\n",
    "        for i, strategy in enumerate(strategies)\n",
    "    }\n",
    "\n",
    "    # Plot\n",
    "    fig, axes = plt.subplots(nrows=3, ncols=3, figsize=(18, 12), sharex=True, sharey=True)\n",
    "    fig.subplots_adjust(hspace=0.3, wspace=0.2)\n",
    "\n",
    "    for row_idx, balance_type in enumerate(balance_order):\n",
    "        for col_idx, label in enumerate(labels):\n",
    "            ax = axes[row_idx][col_idx]\n",
    "            ax.set_title(f\"{label} — {balance_type}\")\n",
    "\n",
    "            for metric_label, metric_list in selected_metrics_dict.items():\n",
    "                if col_idx >= len(metric_list):\n",
    "                    continue\n",
    "\n",
    "                metric_name = metric_list[col_idx]\n",
    "                fam, agg = parse_metric_type(metric_label)\n",
    "                color = family_colors.get(fam, \"black\")\n",
    "                default_style = aggregation_linestyles.get(agg, \"solid\")\n",
    "\n",
    "                for strategy in strategies:\n",
    "                    linestyle = strategy_linestyles.get(strategy, default_style)\n",
    "\n",
    "                    df = df_result[\n",
    "                        (df_result[\"Metric\"] == metric_name) &\n",
    "                        (df_result[\"Balance Type\"] == balance_type) &\n",
    "                        (df_result[\"Compared Strategy\"] == strategy)\n",
    "                    ].copy()\n",
    "\n",
    "                    if df.empty:\n",
    "                        continue\n",
    "\n",
    "                    df[\"Percent change\"] = df[\"Percent change\"].str.replace('%', '', regex=False).astype(float)\n",
    "                    df[\"p-value\"] = df[\"p-value\"].astype(float)\n",
    "                    df = df.sort_values(\"Terminals\")\n",
    "\n",
    "                    ax.plot(\n",
    "                        df[\"Terminals\"],\n",
    "                        df[\"Percent change\"],\n",
    "                        label=f\"{strategy} — {agg} {fam}\",\n",
    "                        linestyle=linestyle,\n",
    "                        color=color,\n",
    "                        linewidth=1.0,\n",
    "                        zorder=1\n",
    "                    )\n",
    "\n",
    "                    for _, row in df.iterrows():\n",
    "                        alpha = determine_alpha(row[\"p-value\"])\n",
    "                        ax.scatter(\n",
    "                            row[\"Terminals\"], row[\"Percent change\"],\n",
    "                            s=20,\n",
    "                            color=color,\n",
    "                            alpha=alpha,\n",
    "                            edgecolor=\"black\" if alpha == 1.0 else \"none\",\n",
    "                            linewidth=0.6,\n",
    "                            zorder=2\n",
    "                        )\n",
    "\n",
    "            ax.axhline(0, color='black', linestyle='--', linewidth=0.8)\n",
    "            if row_idx == 2:\n",
    "                ax.set_xlabel(\"Total Clients\")\n",
    "            if col_idx == 0:\n",
    "                ax.set_ylabel(\"% Change (Strategy vs RR)\")\n",
    "            ax.grid(True)\n",
    "\n",
    "    axes[0][2].legend(title=\"Strategy + Metric\", loc='upper right')\n",
    "    plt.suptitle(\"Welch Test Results: Color = Metric, Line Style = Strategy\", fontsize=16)\n",
    "    plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_relaxed_welch_results(df_relaxed_results, selected_metrics_dict={\n",
    "    \"Avg Latency\": [\n",
    "        \"Premium Avg Latency\",\n",
    "        \"Freemium Avg Latency\",\n",
    "        \"Overall Avg Latency\"\n",
    "    ],\n",
    "    \"Avg Throughput\": [\n",
    "        \"Premium Avg Throughput\",\n",
    "        \"Freemium Avg Throughput\",\n",
    "        \"Overall Avg Throughput\"\n",
    "    ]\n",
    "})\n"
   ]
