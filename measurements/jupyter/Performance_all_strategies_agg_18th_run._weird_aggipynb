    "import pandas as pd\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "def grouped_welch_test_plb_vs_rr(df_all, metrics, baseline_strategy=\"5RR\") -> pd.DataFrame:\n",
    "    results = []\n",
    "    all_strategies = df_all[\"Strategy\"].unique()\n",
    "    strategies_to_test = [s for s in all_strategies if s != baseline_strategy]\n",
    "    terminal_counts = df_all[\"Terminals\"].unique()\n",
    "\n",
    "    for strategy in strategies_to_test:\n",
    "        for term in sorted(terminal_counts):\n",
    "            df_test = df_all[(df_all[\"Strategy\"] == strategy) & (df_all[\"Terminals\"] == term)]\n",
    "            df_base = df_all[\n",
    "                (df_all[\"Strategy\"] == baseline_strategy) &\n",
    "                (df_all[\"Terminals\"] == term) &\n",
    "                (df_all[\"PremiumClients\"] == df_all[\"FreemiumClients\"])  # 50:50 baseline\n",
    "            ]\n",
    "\n",
    "            if df_base.empty:\n",
    "                continue  # skip if no baseline for that terminal count\n",
    "\n",
    "            grouped = df_test.groupby([\"PremiumClients\", \"FreemiumClients\"])\n",
    "\n",
    "            for (prem, free), group_df in grouped:\n",
    "                ratio = f\"{prem}:{free}\"\n",
    "                for metric in metrics:\n",
    "                    test_vals = group_df[metric].dropna()\n",
    "                    base_vals = df_base[metric].dropna()\n",
    "                    if len(test_vals) < 2 or len(base_vals) < 2:\n",
    "                        continue  # Welch's t-test needs at least 2 samples per group\n",
    "\n",
    "                    try:\n",
    "                        t_stat, p_val = ttest_ind(test_vals, base_vals, equal_var=False)\n",
    "                        mean_test = test_vals.mean()\n",
    "                        mean_base = base_vals.mean()\n",
    "                        nx = len(test_vals)\n",
    "                        ny = len(base_vals)\n",
    "                        pooled_std = np.sqrt(\n",
    "                            ((nx - 1) * test_vals.var(ddof=1) + (ny - 1) * base_vals.var(ddof=1)) / (nx + ny - 2)\n",
    "                        )\n",
    "                        d = (mean_test - mean_base) / pooled_std if pooled_std > 0 else 0\n",
    "\n",
    "                        direction = \"improves\" if (\n",
    "                            (\"Latency\" in metric and mean_test < mean_base) or\n",
    "                            (\"Throughput\" in metric and mean_test > mean_base) or\n",
    "                            (\"Goodput\" in metric and mean_test > mean_base)\n",
    "                        ) else \"degrades\"\n",
    "\n",
    "                        results.append({\n",
    "                            \"Terminals\": term,\n",
    "                            \"Ratio\": ratio,\n",
    "                            \"Compared Strategy\": strategy,\n",
    "                            \"Metric\": metric,\n",
    "                            \"Test mean\": round(mean_test, 4),\n",
    "                            \"Baseline mean\": round(mean_base, 4),\n",
    "                            \"Percent change\": f\"{((mean_test - mean_base) / mean_base) * 100:+.2f}%\",\n",
    "                            \"t-stat\": round(t_stat, 4),\n",
    "                            \"p-value\": f\"{p_val:.2e}\",\n",
    "                            \"Cohen's d\": round(d, 4),\n",
    "                            \"Direction\": direction\n",
    "                        })\n",
    "                    except Exception:\n",
    "                        continue\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "    \n",
    "metrics_to_test = [\n",
    "    \"Premium Avg Latency\", \"Freemium Avg Latency\", \"Overall Avg Latency\",\n",
    "    \"Premium Stddev Latency\", \"Freemium Stddev Latency\", \"Overall Stddev Latency\",\n",
    "    \"Premium 95th Latency\", \"Freemium 95th Latency\", \"Overall 95th Latency\",\n",
    "    \"Premium Avg Throughput\", \"Freemium Avg Throughput\", \"Overall Avg Throughput\",\n",
    "    \"Premium Stddev Throughput\", \"Freemium Stddev Throughput\", \"Overall Stddev Throughput\",\n",
    "    \"Premium 95th Throughput\", \"Freemium 95th Throughput\", \"Overall 95th Throughput\"\n",
    "]\n",
    "\n",
    "df_relaxed_results = grouped_welch_test_plb_vs_rr(df_all, metrics_to_test)\n",
    "print(df_relaxed_results)\n"
   ]
