    "# Re-import needed packages due to kernel reset\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "pd.set_option('display.max_rows', 200)\n",
    "def collect_welch_tests_by_strategy(df_all, metrics, baseline_strategy=\"5RR\"):\n",
    "    results = []\n",
    "\n",
    "    strategies = df_all[\"Strategy\"].unique()\n",
    "    strategies = [s for s in strategies if s != baseline_strategy]\n",
    "\n",
    "    for strategy in strategies:\n",
    "        df_base = df_all[df_all[\"Strategy\"] == baseline_strategy]\n",
    "        df_compare = df_all[df_all[\"Strategy\"] == strategy]\n",
    "\n",
    "        for metric in metrics:\n",
    "            try:\n",
    "                x = df_compare[metric].dropna()\n",
    "                y = df_base[metric].dropna()\n",
    "\n",
    "                # Welch's t-test\n",
    "                t_stat, p_val = ttest_ind(x, y, equal_var=False)\n",
    "\n",
    "                # Cohen's d\n",
    "                nx, ny = len(x), len(y)\n",
    "                dof = nx + ny - 2\n",
    "                pooled_std = np.sqrt(((nx - 1) * np.var(x, ddof=1) + (ny - 1) * np.var(y, ddof=1)) / dof)\n",
    "                d = (np.mean(x) - np.mean(y)) / pooled_std\n",
    "\n",
    "                # Descriptive stats\n",
    "                mean_x = np.mean(x)\n",
    "                mean_y = np.mean(y)\n",
    "                is_latency = \"Latency\" in metric\n",
    "                is_better = (mean_x < mean_y) if is_latency else (mean_x > mean_y)\n",
    "                percent_diff = ((mean_x - mean_y) / mean_y) * 100\n",
    "\n",
    "                # Interpretations\n",
    "                if p_val < 0.001:\n",
    "                    p_comment = \"Very significant (*** p < 0.001)\"\n",
    "                elif p_val < 0.01:\n",
    "                    p_comment = \"Significant (** p < 0.01)\"\n",
    "                elif p_val < 0.05:\n",
    "                    p_comment = \"Significant (* p < 0.05)\"\n",
    "                elif p_val < 0.1:\n",
    "                    p_comment = \"Weak evidence (p < 0.1)\"\n",
    "                else:\n",
    "                    p_comment = \"Not significant (p ≥ 0.1)\"\n",
    "\n",
    "                if abs(d) < 0.2:\n",
    "                    magnitude = \"negligible effect\"\n",
    "                elif abs(d) < 0.5:\n",
    "                    magnitude = \"small effect\"\n",
    "                elif abs(d) < 0.8:\n",
    "                    magnitude = \"medium effect\"\n",
    "                else:\n",
    "                    magnitude = \"large effect\"\n",
    "                direction = \"PLB improves\" if (d < 0 if is_latency else d > 0) else \"PLB degrades\"\n",
    "                effect_comment = f\"{direction} ({magnitude})\"\n",
    "\n",
    "                results.append({\n",
    "                    \"Compared Strategy\": strategy,\n",
    "                    \"Metric\": metric,\n",
    "                    \"t-stat\": round(t_stat, 4),\n",
    "                    f\"{strategy} mean\": round(mean_x, 4),\n",
    "                    f\"{baseline_strategy} mean\": round(mean_y, 4),\n",
    "                    \"p-value\": \"{:.4e}\".format(p_val),\n",
    "                    \"p-value comment\": p_comment,\n",
    "                    \"PLB < RR\": mean_x < mean_y,\n",
    "                    \"PLB better?\": is_better,\n",
    "                    \"Cohen's d\": round(d, 4),\n",
    "                    \"Effect comment\": effect_comment,\n",
    "                    \"Percent change\": f\"{percent_diff:+.2f}%\"\n",
    "                })\n",
    "\n",
    "            except Exception as e:\n",
    "                results.append({\n",
    "                    \"Compared Strategy\": strategy,\n",
    "                    \"Metric\": metric,\n",
    "                    \"t-stat\": \"ERROR\",\n",
    "                    f\"{strategy} mean\": None,\n",
    "                    f\"{baseline_strategy} mean\": None,\n",
    "                    \"p-value\": str(e),\n",
    "                    \"p-value comment\": \"N/A\",\n",
    "                    \"PLB < RR\": None,\n",
    "                    \"PLB better?\": None,\n",
    "                    \"Cohen's d\": None,\n",
    "                    \"Effect comment\": \"N/A\",\n",
    "                    \"Percent change\": \"N/A\"\n",
    "                })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
