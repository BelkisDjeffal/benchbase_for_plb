    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "STATS = [\"Avg\", \"Median\", \"Max\", \"95th\"]\n",
    "CATS  = [\"Latency\", \"Throughput\", \"Goodput\"]\n",
    "\n",
    "def _copy_overall_to_unprefixed(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    df = df.copy()\n",
    "    for s in STATS:\n",
    "        for m in CATS:\n",
    "            src, dst = f\"Overall {s} {m}\", f\"{s} {m}\"\n",
    "            if src in df.columns:\n",
    "                df[dst] = df[src]\n",
    "    return df\n",
    "\n",
    "def _agg_side(df_side: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Aggregate duplicates at same (Strategy, ClientCount) within a side.\"\"\"\n",
    "    if df_side.empty:\n",
    "        return df_side.copy()\n",
    "\n",
    "    side = df_side.copy()\n",
    "    # robust numeric weights\n",
    "    side[\"__w__\"] = pd.to_numeric(side.get(\"Measured Requests\", 0), errors=\"coerce\").fillna(0.0)\n",
    "\n",
    "    metric_cols = [f\"Overall {s} {m}\" for s in STATS for m in CATS if f\"Overall {s} {m}\" in side.columns]\n",
    "\n",
    "    def reduce_group(g: pd.DataFrame) -> pd.Series:\n",
    "        out = {\"Measured Requests\": g[\"__w__\"].sum()}\n",
    "        wsum = out[\"Measured Requests\"]\n",
    "\n",
    "        for s in STATS:\n",
    "            for m in CATS:\n",
    "                col = f\"Overall {s} {m}\"\n",
    "                if col not in g.columns:\n",
    "                    continue\n",
    "                v = pd.to_numeric(g[col], errors=\"coerce\")\n",
    "\n",
    "                if s == \"Avg\":\n",
    "                    mask = v.notna()\n",
    "                    if mask.any():\n",
    "                        w = g.loc[mask, \"__w__\"]\n",
    "                        out[col] = np.average(v[mask], weights=w) if w.sum() > 0 else v[mask].mean()\n",
    "                    else:\n",
    "                        out[col] = np.nan\n",
    "\n",
    "                elif s == \"Max\":\n",
    "                    out[col] = v.max(skipna=True)\n",
    "\n",
    "                else:  # Median / 95th — pick row with largest weight among non-NaN\n",
    "                    mask = v.notna()\n",
    "                    if mask.any():\n",
    "                        # idx of largest weight among valid rows\n",
    "                        idx = g.loc[mask, \"__w__\"].idxmax()\n",
    "                        out[col] = g.loc[idx, col]\n",
    "                    else:\n",
    "                        out[col] = np.nan\n",
    "\n",
    "        return pd.Series(out)\n",
    "\n",
    "    agg = (\n",
    "        side.groupby([\"Strategy\", \"ClientCount\"])\n",
    "            .apply(reduce_group, include_groups=False)\n",
    "            .reset_index()\n",
    "    )\n",
    "\n",
    "    return agg\n",
    "\n",
    "def build_comparisons(df_overall, combo_pairs, group,\n",
    "                      target_strategies=(\"6RR\",\"5PLB\",\"5PLB2\",\"5RR\"),\n",
    "                      weight_by=\"Measured Requests\"):\n",
    "    assert group in (\"Overall\",\"Premium\",\"Freemium\")\n",
    "\n",
    "    # slice by source\n",
    "    prem_only_raw = df_overall[(df_overall[\"Source\"]==\"PremiumOnly\")  & (df_overall[\"Variant\"]==\"All\")].copy()\n",
    "    free_only_raw = df_overall[(df_overall[\"Source\"]==\"FreemiumOnly\") & (df_overall[\"Variant\"]==\"All\")].copy()\n",
    "    mixed         = df_overall[(df_overall[\"Source\"]==\"Mixed\")       & (df_overall[\"Variant\"]==\"All\")].copy()\n",
    "\n",
    "    # --- V3: pre-aggregate duplicates within each side ---\n",
    "    prem_only = _agg_side(prem_only_raw)\n",
    "    free_only = _agg_side(free_only_raw)\n",
    "\n",
    "    # --- REAL (Variant == \"All\"), x-axis = TOTAL clients (from Mixed) ---\n",
    "    real = mixed[mixed[\"Strategy\"].isin(target_strategies)].copy()\n",
    "    if group == \"Overall\":\n",
    "        for s in STATS:\n",
    "            for m in CATS:\n",
    "                src, dst = f\"Overall {s} {m}\", f\"{s} {m}\"\n",
    "                if src in real.columns: real[dst] = real[src]\n",
    "        real[\"Group\"] = \"Overall\";  real[\"Variant\"] = \"All\"\n",
    "    elif group == \"Premium\":\n",
    "        for s in STATS:\n",
    "            for m in CATS:\n",
    "                src, dst = f\"Premium {s} {m}\", f\"{s} {m}\"\n",
    "                if src in real.columns: real[dst] = real[src]\n",
    "        real[\"Group\"] = \"Premium\";  real[\"Variant\"] = \"All\"\n",
    "    else:  # Freemium\n",
    "        for s in STATS:\n",
    "            for m in CATS:\n",
    "                src, dst = f\"Freemium {s} {m}\", f\"{s} {m}\"\n",
    "                if src in real.columns: real[dst] = real[src]\n",
    "        real[\"Group\"] = \"Freemium\"; real[\"Variant\"] = \"All\"\n",
    "\n",
    "    keep_real = [\"Strategy\",\"ClientCount\",\"Group\",\"Variant\",\"Measured Requests\"] + \\\n",
    "                [f\"{s} {m}\" for s in STATS for m in CATS if f\"{s} {m}\" in real.columns]\n",
    "    real = real[keep_real].copy()\n",
    "\n",
    "    # --- HYBRIDS (x = P + F for ALL views), using aggregated sides ---\n",
    "    hybrid_rows = []\n",
    "    prem_idx = prem_only.set_index([\"Strategy\",\"ClientCount\"]) if not prem_only.empty else None\n",
    "    free_idx = free_only.set_index([\"Strategy\",\"ClientCount\"]) if not free_only.empty else None\n",
    "\n",
    "    for prem_strat, free_strat in combo_pairs:\n",
    "        Ps = prem_only.loc[prem_only[\"Strategy\"]==prem_strat, \"ClientCount\"].unique() if prem_idx is not None else []\n",
    "        Fs = free_only.loc[free_only[\"Strategy\"]==free_strat, \"ClientCount\"].unique() if free_idx is not None else []\n",
    "\n",
    "        for P in Ps:\n",
    "            for F in Fs:\n",
    "                if prem_idx is None or free_idx is None:\n",
    "                    continue\n",
    "                pk, fk = (prem_strat, P), (free_strat, F)\n",
    "                if pk not in prem_idx.index or fk not in free_idx.index:\n",
    "                    continue\n",
    "\n",
    "                # aggregated rows (unique per key)\n",
    "                prow = prem_idx.loc[pk]\n",
    "                frow = free_idx.loc[fk]\n",
    "\n",
    "                # robust weights for cross-side averaging\n",
    "                p_req = float(prow.get(\"Measured Requests\", 0)) or float(P)\n",
    "                f_req = float(frow.get(\"Measured Requests\", 0)) or float(F)\n",
    "                tot_req = max(p_req + f_req, 1.0)\n",
    "                total_clients = int(P) + int(F)\n",
    "\n",
    "                if group == \"Premium\":\n",
    "                    out = {\"Strategy\": f\"{prem_strat}+{free_strat}\",\n",
    "                           \"ClientCount\": total_clients,\n",
    "                           \"Group\": \"Premium\", \"Source\": \"Hybrid\", \"Variant\": \"Hybrid\",\n",
    "                           \"Measured Requests\": p_req}\n",
    "                    for s in STATS:\n",
    "                        for m in CATS:\n",
    "                            out[f\"{s} {m}\"] = prow.get(f\"Overall {s} {m}\", np.nan)\n",
    "                    hybrid_rows.append(out)\n",
    "\n",
    "                elif group == \"Freemium\":\n",
    "                    out = {\"Strategy\": f\"{prem_strat}+{free_strat}\",\n",
    "                           \"ClientCount\": total_clients,\n",
    "                           \"Group\": \"Freemium\", \"Source\": \"Hybrid\", \"Variant\": \"Hybrid\",\n",
    "                           \"Measured Requests\": f_req}\n",
    "                    for s in STATS:\n",
    "                        for m in CATS:\n",
    "                            out[f\"{s} {m}\"] = frow.get(f\"Overall {s} {m}\", np.nan)\n",
    "                    hybrid_rows.append(out)\n",
    "\n",
    "                else:  # Overall\n",
    "                    out = {\"Strategy\": f\"{prem_strat}+{free_strat}\",\n",
    "                           \"ClientCount\": total_clients,\n",
    "                           \"Group\": \"Overall\", \"Source\": \"Hybrid\", \"Variant\": \"Hybrid\",\n",
    "                           \"Measured Requests\": p_req + f_req}\n",
    "                    for s in STATS:\n",
    "                        for m in CATS:\n",
    "                            vp = prow.get(f\"Overall {s} {m}\", np.nan)\n",
    "                            vf = frow.get(f\"Overall {s} {m}\", np.nan)\n",
    "                            if np.isnan(vp) or np.isnan(vf):\n",
    "                                out[f\"{s} {m}\"] = np.nan\n",
    "                            elif s == \"Avg\":\n",
    "                                out[f\"{s} {m}\"] = (p_req*vp + f_req*vf) / tot_req\n",
    "                            elif s == \"Max\":\n",
    "                                out[f\"{s} {m}\"] = max(vp, vf)\n",
    "                            else:  # Median / 95th\n",
    "                                out[f\"{s} {m}\"] = vp if p_req >= f_req else vf\n",
    "                    hybrid_rows.append(out)\n",
    "\n",
    "    df_hybrid = pd.DataFrame(hybrid_rows)\n",
    "\n",
    "    # Make comparison apples-to-apples: keep \"real\" only where hybrids exist (like v1)\n",
    "    if not df_hybrid.empty and \"ClientCount\" in df_hybrid:\n",
    "        totals = set(df_hybrid[\"ClientCount\"].unique())\n",
    "        real = real[real[\"ClientCount\"].isin(totals)].copy()\n",
    "\n",
    "    return df_hybrid, real\n",
    "\n",
    "\n",
    "def _isnan(x):\n",
    "    try:\n",
    "        return np.isnan(x)\n",
    "    except Exception:\n",
    "        return False\n",
    "\n",
    "def _coalesce(*vals):\n",
    "    for v in vals:\n",
    "        if v is None:\n",
    "            continue\n",
    "        if isinstance(v, str) and v.strip() == \"\":\n",
    "            continue\n",
    "        if _isnan(v):\n",
    "            continue\n",
    "        return v\n",
    "    return np.nan\n",
    "\n",
    "\n",
    "def summarize_hybrid(df_hybrid: pd.DataFrame, metric=\"Latency\", group_label=\"Overall\"):\n",
    "    colA, colM, col95, colMed = f\"Avg {metric}\", f\"Max {metric}\", f\"95th {metric}\", f\"Median {metric}\"\n",
    "    out = []\n",
    "    for (s, c), g in df_hybrid.groupby([\"Strategy\",\"ClientCount\"]):\n",
    "        rec = {\"Strategy\": s, \"ClientCount\": c, \"Group\": group_label, \"Variant\": \"Hybrid\"}\n",
    "\n",
    "        # --- Avg (robust weights) ---\n",
    "        if colA in g.columns:\n",
    "            A = g[[colA, \"Measured Requests\"]].copy()\n",
    "            A = A[A[colA].notna()]  # keep rows with a value\n",
    "            if not A.empty:\n",
    "                w = A[\"Measured Requests\"].astype(float).fillna(0.0)\n",
    "                if w.sum() == 0:\n",
    "                    w = np.ones(len(A), dtype=float)   # fallback equal weights\n",
    "                rec[\"Measured Requests\"] = w.sum()\n",
    "                rec[colA] = np.average(A[colA].astype(float), weights=w)\n",
    "\n",
    "        # --- Max ---\n",
    "        if colM in g.columns and g[colM].notna().any():\n",
    "            rec[colM] = g[colM].dropna().max()\n",
    "\n",
    "        # --- 95th ---\n",
    "        if col95 in g.columns and g[col95].notna().any():\n",
    "            rec[col95] = np.percentile(g[col95].dropna(), 95)\n",
    "\n",
    "        # --- Median ---\n",
    "        if colMed in g.columns and g[colMed].notna().any():\n",
    "            rec[colMed] = np.median(g[colMed].dropna())\n",
    "\n",
    "        out.append(rec)\n",
    "    return pd.DataFrame(out)\n",
    "\n",
    "\n",
    "\n",
    "def plot_comparison(df_real, df_hybrid_sum, metric=\"Latency\", stat=\"Avg\", group_label=\"Overall\", title=None):\n",
    "    col = f\"{stat} {metric}\"\n",
    "    R, H = df_real.copy(), df_hybrid_sum.copy()\n",
    "\n",
    "    # keep only \"All\" in real; hybrids stay as-is\n",
    "    if \"Variant\" in R.columns:\n",
    "        R = R[R[\"Variant\"] == \"All\"]\n",
    "\n",
    "    shared = set(R[\"ClientCount\"].unique()) & set(H[\"ClientCount\"].unique())\n",
    "    R = R[R[\"ClientCount\"].isin(shared)]\n",
    "    H = H[H[\"ClientCount\"].isin(shared)]\n",
    "\n",
    "    keep = [\"Strategy\",\"ClientCount\",\"Group\",col]\n",
    "    R = R[keep].copy(); H = H[keep].copy()\n",
    "\n",
    "    R[\"Series\"] = \"Real\"\n",
    "    H[\"Series\"] = \"Hybrid\"\n",
    "\n",
    "    df_plot = pd.concat([R, H], ignore_index=True)\n",
    "\n",
    "    order_x = sorted(df_plot[\"ClientCount\"].unique())\n",
    "    df_plot[\"ClientCount_str\"] = pd.Categorical(df_plot[\"ClientCount\"].astype(str),\n",
    "                                                categories=[str(x) for x in order_x], ordered=True)\n",
    "    strat_order = sorted(df_plot[\"Strategy\"].unique())\n",
    "    df_plot[\"Strategy\"] = pd.Categorical(df_plot[\"Strategy\"], categories=strat_order, ordered=True)\n",
    "\n",
    "    plt.figure(figsize=(12,6))\n",
    "    sns.lineplot(\n",
    "        data=df_plot, x=\"ClientCount_str\", y=col,\n",
    "        hue=\"Strategy\", marker=\"o\", linewidth=2, errorbar=\"sd\"\n",
    "    )\n",
    "    ttl = title or f\"{group_label} {metric} ({stat}) — Hybrid vs Mixed (Only All)\"\n",
    "    plt.title(ttl)\n",
    "    plt.xlabel(\"Total Clients\")\n",
    "    plt.ylabel(f\"{metric} ({stat})\")\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.grid(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "#combo_pairs = [(\"4RR\",\"1RR\"), (\"3RR\",\"2RR\"), (\"4RR\",\"3RR\"), (\"4RR\",\"2RR\")]\n",
    "combo_pairs = [(\"3LL\",\"2LL\"), (\"3RR\",\"2RR\")] #(\"4RR\",\"1RR\"),  (\"3LL\",\"2LL\"),\n",
    "#target = [\"6RR\",\"6PLB2\",\"5PLB\",\"5PLB2\",\"5RR\"]\n",
    "#target =[\"5PLB2\",\"5RR_all\"]\n",
    "target =[\"5PLB20\",\"6RR\",\"5RR\",\"5RR2\",\"5LL\",\"5PLB8\",\"5PLB10\",\"5PLB11\", \"5PLB12\",\"5PLB8_2\",\"5PLB10_2\", \"5PLB9\",\"6PLB6\",\"6PLB6_60\"]\n",
    "\n",
    "# Overall\n",
    "hyb_O, real_O = build_comparisons(df_overall, combo_pairs, group=\"Overall\",  target_strategies=target)\n",
    "sum_O = summarize_hybrid(hyb_O, metric=\"Latency\", group_label=\"Overall\")\n",
    "plot_comparison(real_O, sum_O, metric=\"Latency\", stat=\"Avg\", group_label=\"Overall\")\n",
    "\n",
    "# Premium\n",
    "hyb_P, real_P = build_comparisons(df_overall, combo_pairs, group=\"Premium\",  target_strategies=target)\n",
    "sum_P = summarize_hybrid(hyb_P, metric=\"Latency\", group_label=\"Premium\")\n",
    "plot_comparison(real_P, sum_P, metric=\"Latency\", stat=\"Avg\", group_label=\"Premium\")\n",
    "\n",
    "# Freemium\n",
    "hyb_F, real_F = build_comparisons(df_overall, combo_pairs, group=\"Freemium\", target_strategies=target)\n",
    "sum_F = summarize_hybrid(hyb_F, metric=\"Latency\", group_label=\"Freemium\")\n",
    "plot_comparison(real_F, sum_F, metric=\"Latency\", stat=\"Avg\", group_label=\"Freemium\")\n"
   ]
  },
