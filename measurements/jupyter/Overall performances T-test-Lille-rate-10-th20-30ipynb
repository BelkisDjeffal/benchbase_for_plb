    "def collect_welch_tests_by_terminals(df_plb, df_rr, metrics, key_col=\"Terminals\"):\n",
    "    results = []\n",
    "    terminals = sorted(set(df_plb[key_col]) & set(df_rr[key_col]))\n",
    "\n",
    "    for t in terminals:\n",
    "        df_plb_sub = df_plb[df_plb[key_col] == t]\n",
    "        df_rr_sub = df_rr[df_rr[key_col] == t]\n",
    "\n",
    "        for metric in metrics:\n",
    "            try:\n",
    "                plb_vals = df_plb_sub[metric].dropna()\n",
    "                rr_vals = df_rr_sub[metric].dropna()\n",
    "\n",
    "                if len(plb_vals) < 2 or len(rr_vals) < 2:\n",
    "                    raise ValueError(\"Not enough data points (need at least 2)\")\n",
    "\n",
    "                t_stat, p_val = ttest_ind(plb_vals, rr_vals, equal_var=False)\n",
    "                d = cohen_d(plb_vals, rr_vals)\n",
    "\n",
    "                plb_mean = plb_vals.mean()\n",
    "                rr_mean = rr_vals.mean()\n",
    "                is_latency = \"Latency\" in metric\n",
    "                is_better = (plb_mean < rr_mean) if is_latency else (plb_mean > rr_mean)\n",
    "                percent_diff = ((plb_mean - rr_mean) / rr_mean) * 100\n",
    "\n",
    "                results.append({\n",
    "                    \"Terminals\": t,\n",
    "                    \"Metric\": metric,\n",
    "                    \"t-stat\": round(t_stat, 4),\n",
    "                    \"PLB mean\": round(plb_mean, 4),\n",
    "                    \"RR mean\": round(rr_mean, 4),\n",
    "                    \"p-value\": \"{:.4e}\".format(p_val),\n",
    "                    \"p-value comment\": interpret_p_value(p_val),\n",
    "                    \"PLB < RR\": plb_mean < rr_mean,\n",
    "                    \"PLB better?\": is_better,\n",
    "                    \"Cohen's d\": round(d, 4),\n",
    "                    \"Effect comment\": interpret_effect_size(d, is_latency),\n",
    "                    \"Percent change\": f\"{percent_diff:+.2f}%\"\n",
    "                })\n",
    "\n",
    "            except Exception as e:\n",
    "                results.append({\n",
    "                    \"Terminals\": t,\n",
    "                    \"Metric\": metric,\n",
    "                    \"t-stat\": \"ERROR\",\n",
    "                    \"PLB mean\": None,\n",
    "                    \"RR mean\": None,\n",
    "                    \"p-value\": str(e),\n",
    "                    \"p-value comment\": \"N/A\",\n",
    "                    \"PLB < RR\": None,\n",
    "                    \"PLB better?\": None,\n",
    "                    \"Cohen's d\": None,\n",
    "                    \"Effect comment\": \"N/A\",\n",
    "                    \"Percent change\": \"N/A\"\n",
    "                })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "\n",
    "premium_metrics = [\n",
    "    \"Premium Avg Throughput\", \"Premium Stddev Throughput\", \"Premium 95th Throughput\",\n",
    "    \"Premium Avg Goodput\", \"Premium Stddev Goodput\", \"Premium 95th Goodput\",\n",
    "    \"Premium Avg Latency\", \"Premium Stddev Latency\", \"Premium 95th Latency\"\n",
    "]\n",
    "freemium_metrics = [\n",
    "    \"Freemium Avg Throughput\", \"Freemium Stddev Throughput\", \"Freemium 95th Throughput\",\n",
    "    \"Freemium Avg Goodput\", \"Freemium Stddev Goodput\", \"Freemium 95th Goodput\",\n",
    "    \"Freemium Avg Latency\", \"Freemium Stddev Latency\", \"Freemium 95th Latency\"\n",
    "]\n",
    "overall_metrics = [\n",
    "    \"Overall Avg Throughput\", \"Overall Stddev Throughput\", \"Overall 95th Throughput\",\n",
    "    \"Overall Avg Goodput\",   \"Overall Stddev Goodput\",   \"Overall 95th Goodput\",\n",
    "    \"Overall Avg Latency\",   \"Overall Stddev Latency\",   \"Overall 95th Latency\"\n",
    "]\n",
    "\n",
    "overall_paired_terminal_results = collect_welch_tests_by_terminals(df, df_rr, overall_metrics)\n",
    "freemium_paired_terminal_results = collect_welch_tests_by_terminals(df, df_rr, freemium_metrics)\n",
    "premium_paired_terminal_results = collect_welch_tests_by_terminals(df, df_rr, premium_metrics)\n",
    "\n",
    "df_results = pd.concat([\n",
    "    overall_paired_terminal_results,\n",
    "    freemium_paired_terminal_results,\n",
    "    premium_paired_terminal_results\n",
    "], ignore_index=True)\n",
    "\n",
    "\n",
    "def classify_metric_family(metric_name):\n",
    "    if \"Throughput\" in metric_name:\n",
    "        return \"Throughput\"\n",
    "    elif \"Goodput\" in metric_name:\n",
    "        return \"Goodput\"\n",
    "    elif \"Latency\" in metric_name:\n",
    "        return \"Latency\"\n",
    "    else:\n",
    "        return \"Other\"\n",
    "\n",
    "df_results[\"Metric Family\"] = df_results[\"Metric\"].apply(classify_metric_family)\n",
    "\n",
    "throughput_df = df_results[df_results[\"Metric Family\"] == \"Throughput\"]\n",
    "goodput_df = df_results[df_results[\"Metric Family\"] == \"Goodput\"]\n",
    "latency_df = df_results[df_results[\"Metric Family\"] == \"Latency\"]\n",
    "\n",
    "avg_throughput_df = df_results[\n",
    "    (df_results[\"Metric Family\"] == \"Throughput\") &\n",
    "    (df_results[\"Metric\"].str.contains(\"Avg Throughput\"))\n",
    "]\n",
    "\n",
    "\n",
    "\n",
    "avg_goodput_df = df_results[\n",
    "    (df_results[\"Metric Family\"] == \"Goodput\") &\n",
