    "def collect_knees_and_saturation_points(df_plb, df_rr, metrics, label=\"Overall\"):\n",
    "    results = []\n",
    "\n",
    "    for metric_suffix in metrics:\n",
    "        metric_col = f\"{label} {metric_suffix}\"\n",
    "        for strategy, df_data in [(\"PLB\", df_plb), (\"RR\", df_rr)]:\n",
    "            if metric_col not in df_data.columns:\n",
    "                continue\n",
    "            grouped = df_data.groupby(\"Terminals\")[metric_col].mean().reset_index()\n",
    "            X = grouped[\"Terminals\"].values\n",
    "            Y = grouped[metric_col].values\n",
    "\n",
    "            if \"Latency\" in metric_col:\n",
    "                kn = KneeLocator(X, Y, curve='concave', direction='increasing')\n",
    "            elif \"Throughput\" in metric_col:\n",
    "                kn = KneeLocator(X, Y, curve='convex', direction='decreasing')\n",
    "            else:\n",
    "                kn = KneeLocator(X, Y, curve='concave', direction='increasing')  # fallback\n",
    "\n",
    "            knee_point = kn.knee\n",
    "\n",
    "            slopes = np.diff(Y) / np.diff(X)\n",
    "            slope_drop_idx = np.argmax(slopes <= 0) + 1 if np.any(slopes <= 0) else None\n",
    "            slope_point = X[slope_drop_idx] if slope_drop_idx is not None else None\n",
    "\n",
    "            results.append({\n",
    "                \"Metric\": metric_col,\n",
    "                \"Strategy\": strategy,\n",
    "                \"Knee Point\": knee_point,\n",
    "                \"Slope Drop Point\": slope_point\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "metrics_to_check = [\"Avg Throughput\", \"Stddev Throughput\", \"95th Throughput\",\n",
    "                    \"Avg Latency\", \"Stddev Latency\", \"95th Latency\"]\n",
    "saturation_summary = collect_knees_and_saturation_points(df, df_rr, metrics_to_check)\n",
    "display(saturation_summary)"
   ]
