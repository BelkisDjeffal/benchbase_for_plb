    "def detect_saturation_from_two_dfs(df_plb, df_rr, metric=\"Overall Avg Throughput\"):\n",
    "    \"\"\"\n",
    "    Detects saturation points for PLB and RR using throughput or latency.\n",
    "    \n",
    "    Parameters:\n",
    "    - df_plb: DataFrame for PLB\n",
    "    - df_rr: DataFrame for RR\n",
    "    - metric: column to analyze, e.g. 'Overall Avg Throughput'\n",
    "    \"\"\"\n",
    "\n",
    "    # Add strategy labels\n",
    "    df_plb_labeled = df_plb.copy()\n",
    "    df_rr_labeled = df_rr.copy()\n",
    "    df_plb_labeled[\"Strategy\"] = \"PLB\"\n",
    "    df_rr_labeled[\"Strategy\"] = \"RR\"\n",
    "\n",
    "    df_all = pd.concat([df_plb_labeled, df_rr_labeled])\n",
    "\n",
    "    for strategy in [\"PLB\", \"RR\"]:\n",
    "        subset = df_all[df_all[\"Strategy\"] == strategy]\n",
    "        grouped = subset.groupby(\"Terminals\")[metric].mean().reset_index()\n",
    "\n",
    "        X = grouped[\"Terminals\"].values\n",
    "        Y = grouped[metric].values\n",
    "\n",
    "        # Slope drop\n",
    "        slopes = np.diff(Y) / np.diff(X)\n",
    "        slope_drop_idx = np.argmax(slopes <= 0) + 1 if np.any(slopes <= 0) else None\n",
    "        slope_point = X[slope_drop_idx] if slope_drop_idx is not None else None\n",
    "\n",
    "        # Knee detection\n",
    "        kn = KneeLocator(X, Y, curve='concave', direction='increasing')\n",
    "        knee_point = kn.knee\n",
    "\n",
    "        # Plot\n",
    "        plt.plot(X, Y, marker='o', label=f\"{strategy}\")\n",
    "        if slope_point:\n",
    "            plt.axvline(slope_point, linestyle=\"--\", color=\"red\", alpha=0.5, label=f\"{strategy} Slope Drop @ {slope_point}\")\n",
    "        if knee_point:\n",
    "            plt.axvline(knee_point, linestyle=\":\", color=\"green\", alpha=0.5, label=f\"{strategy} Knee @ {knee_point}\")\n",
    "\n",
    "        print(f\"[{strategy}] Slope drop at: {slope_point}\")\n",
    "        print(f\"[{strategy}] Knee point at: {knee_point}\")\n",
    "\n",
    "    plt.title(f\"Saturation Detection: {metric}\")\n",
    "    plt.xlabel(\"Terminals\")\n",
    "    plt.ylabel(metric)\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
