    "        return \"Very significant (*** p < 0.001)\"\n",
    "    elif p < 0.01:\n",
    "        return \"Significant (** p < 0.01)\"\n",
    "    elif p < 0.05:\n",
    "        return \"Significant (* p < 0.05)\"\n",
    "    elif p < 0.1:\n",
    "        return \"Weak evidence (p < 0.1)\"\n",
    "    else:\n",
    "        return \"Not significant (p ≥ 0.1)\"\n",
    "\n",
    "def cohen_d(x, y):\n",
    "    nx = len(x)\n",
    "    ny = len(y)\n",
    "    dof = nx + ny - 2\n",
    "    pooled_std = np.sqrt(((nx - 1) * np.var(x, ddof=1) + (ny - 1) * np.var(y, ddof=1)) / dof)\n",
    "    return (np.mean(x) - np.mean(y)) / pooled_std\n",
    "\n",
    "def interpret_effect_size(d, is_latency):\n",
    "    abs_d = abs(d)\n",
    "    if abs_d < 0.2:\n",
    "        magnitude = \"negligible effect\"\n",
    "    elif abs_d < 0.5:\n",
    "        magnitude = \"small effect\"\n",
    "    elif abs_d < 0.8:\n",
    "        magnitude = \"medium effect\"\n",
    "    else:\n",
    "        magnitude = \"large effect\"\n",
    "    direction = \"PLB improves\" if (d < 0 if is_latency else d > 0) else \"PLB degrades\"\n",
    "    return f\"{direction} ({magnitude})\"\n",
    "\n",
    "def collect_paired_ttests(df_plb, df_rr, metrics, key_cols=[\"Terminals\", \"PremiumClients\"]):\n",
    "    results = []\n",
    "    df_plb = df_plb[df_plb[\"PremiumClients\"] == df_plb[\"FreemiumClients\"]].copy()\n",
    "\n",
    "    def make_config_key(df):\n",
    "        return df[key_cols[0]].astype(str) + \"_\" + df[key_cols[1]].astype(str)\n",
    "\n",
    "    df_plb = df_plb.assign(config_key=make_config_key(df_plb))\n",
    "    df_rr = df_rr.assign(config_key=make_config_key(df_rr))\n",
    "\n",
    "    for metric in metrics:\n",
    "        try:\n",
    "            plb_grouped = df_plb.groupby(\"config_key\")[metric].mean()\n",
    "            rr_grouped = df_rr.groupby(\"config_key\")[metric].mean()\n",
    "\n",
    "            common_keys = plb_grouped.index.intersection(rr_grouped.index)\n",
    "            plb_vals = plb_grouped.loc[common_keys]\n",
    "            rr_vals = rr_grouped.loc[common_keys]\n",
    "\n",
    "            t_stat, p_val = ttest_rel(plb_vals, rr_vals)\n",
    "            d = cohen_d(plb_vals, rr_vals)\n",
    "\n",
    "            plb_mean = plb_vals.mean()\n",
    "            rr_mean = rr_vals.mean()\n",
    "            is_latency = \"Latency\" in metric\n",
    "            is_better = (plb_mean < rr_mean) if is_latency else (plb_mean > rr_mean)\n",
    "            percent_diff = ((plb_mean - rr_mean) / rr_mean) * 100\n",
    "\n",
    "            results.append({\n",
    "                \"Metric\": metric,\n",
    "                \"t-stat\": round(t_stat, 4),\n",
    "                \"PLB mean\": round(plb_mean, 4),\n",
    "                \"RR mean\": round(rr_mean, 4),\n",
    "                \"p-value\": \"{:.4e}\".format(p_val),\n",
    "                \"p-value comment\": interpret_p_value(p_val),\n",
    "                \"PLB < RR\": plb_mean < rr_mean,\n",
    "                \"PLB better?\": is_better,\n",
    "                \"Cohen's d\": round(d, 4),\n",
    "                \"Effect comment\": interpret_effect_size(d, is_latency),\n",
    "                \"Percent change\": f\"{percent_diff:+.2f}%\"\n",
    "            })\n",
    "\n",
    "        except Exception as e:\n",
    "            results.append({\n",
    "                \"Metric\": metric,\n",
    "                \"t-stat\": \"ERROR\",\n",
    "                \"PLB mean\": None,\n",
    "                \"RR mean\": None,\n",
    "                \"p-value\": str(e),\n",
    "                \"p-value comment\": \"N/A\",\n",
    "                \"PLB < RR\": None,\n",
    "                \"PLB better?\": None,\n",
    "                \"Cohen's d\": None,\n",
    "                \"Effect comment\": \"N/A\",\n",
    "                \"Percent change\": \"N/A\"\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "def collect_welch_ttests(df_plb, df_rr, metrics):\n",
    "    results = []\n",
    "\n",
    "    for metric in metrics:\n",
    "        try:\n",
    "            plb_vals = df_plb[metric].dropna()\n",
    "            rr_vals = df_rr[metric].dropna()\n",
    "\n",
    "            t_stat, p_val = ttest_ind(plb_vals, rr_vals, equal_var=False)\n",
    "            d = cohen_d(plb_vals, rr_vals)\n",
    "\n",
    "            plb_mean = plb_vals.mean()\n",
    "            rr_mean = rr_vals.mean()\n",
    "            is_latency = \"Latency\" in metric\n",
    "            is_better = (plb_mean < rr_mean) if is_latency else (plb_mean > rr_mean)\n",
    "            percent_diff = ((plb_mean - rr_mean) / rr_mean) * 100\n",
    "\n",
    "            results.append({\n",
    "                \"Metric\": metric,\n",
    "                \"t-stat\": round(t_stat, 4),\n",
    "                \"PLB mean\": round(plb_mean, 4),\n",
    "                \"RR mean\": round(rr_mean, 4),\n",
    "                \"p-value\": \"{:.4e}\".format(p_val),\n",
    "                \"p-value comment\": interpret_p_value(p_val),\n",
    "                \"PLB < RR\": plb_mean < rr_mean,\n",
    "                \"PLB better?\": is_better,\n",
    "                \"Cohen's d\": round(d, 4),\n",
    "                \"Effect comment\": interpret_effect_size(d, is_latency),\n",
    "                \"Percent change\": f\"{percent_diff:+.2f}%\"\n",
    "            })\n",
    "\n",
    "        except Exception as e:\n",
    "            results.append({\n",
    "                \"Metric\": metric,\n",
    "                \"t-stat\": \"ERROR\",\n",
    "                \"PLB mean\": None,\n",
    "                \"RR mean\": None,\n",
    "                \"p-value\": str(e),\n",
    "                \"p-value comment\": \"N/A\",\n",
