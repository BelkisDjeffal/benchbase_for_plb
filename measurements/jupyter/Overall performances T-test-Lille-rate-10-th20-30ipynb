    "def plot_metric_summary(metric_name, metrics_df):\n",
    "\n",
    "    df = metrics_df[metrics_df[\"Metric\"] == metric_name].copy()\n",
    "    if df.empty:\n",
    "        print(f\"No data found for metric: {metric_name}\")\n",
    "        return\n",
    "\n",
    "    df = df.sort_values(\"Terminals\")\n",
    "    df[\"p-value\"] = df[\"p-value\"].astype(float)\n",
    "    df[\"Cohen's d\"] = df[\"Cohen's d\"].astype(float)\n",
    "\n",
    "    df[\"Percent change\"] = df[\"Percent change\"].str.replace('%','').astype(float)\n",
    "\n",
    "    def color(row):\n",
    "        if row[\"p-value\"] < 0.05:\n",
    "            return 'green' if row[\"PLB better?\"] else 'red'\n",
    "        else:\n",
    "            return 'gray'\n",
    "    df[\"Color\"] = df.apply(color, axis=1)\n",
    "\n",
    "    df[\"Size\"] = df[\"Cohen's d\"].abs() * 300  # scale factor\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    plt.scatter(df[\"Terminals\"], df[\"Percent change\"], \n",
    "                s=df[\"Size\"], \n",
    "                c=df[\"Color\"], \n",
    "                alpha=0.7, edgecolors='k')\n",
    "\n",
    "    plt.axhline(0, color='black', linestyle='--')\n",
    "    plt.axhline(-5, color='blue', linestyle=':', label='5% improvement')\n",
    "    plt.axhline(5, color='orange', linestyle=':', label='5% degradation')\n",
    "\n",
    "    plt.xlabel(\"Number of Terminals\")\n",
    "    plt.ylabel(\"% Change in Metric\")\n",
    "    plt.title(f\"PLB vs RR for: {metric_name}\")\n",
    "    plt.grid(True)\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
