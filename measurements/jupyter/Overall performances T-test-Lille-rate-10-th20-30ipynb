    "from scipy.stats import ttest_ind\n",
    "import pandas as pd\n",
    "\n",
    "def ttest_premium_vs_freemium_per_config(df, config_col, premium_col, freemium_col):\n",
    "    results = []\n",
    "    configs = df[config_col].unique()\n",
    "    \n",
    "    for conf in configs:\n",
    "        subdf = df[df[config_col] == conf]\n",
    "        g1 = subdf[premium_col].dropna()\n",
    "        g2 = subdf[freemium_col].dropna()\n",
    "        if len(g1) > 2 and len(g2) > 2:\n",
    "            stat, pval = ttest_ind(g1, g2, equal_var=False)\n",
    "            results.append({\n",
    "                \"Config\": conf,\n",
    "                \"Premium Mean\": g1.mean(),\n",
    "                \"Freemium Mean\": g2.mean(),\n",
    "                \"p-value\": pval\n",
    "            })\n",
    "    return pd.DataFrame(results)\n"
   ]
  },
