    "from scipy.stats import shapiro\n",
    "\n",
    "def run_shapiro_tests(df, prefix, metrics=[\"Avg\", \"Stddev\", \"95th\"], value_suffix=\"Latency\"):\n",
    "    \"\"\"\n",
    "    Runs Shapiro-Wilk normality tests on latency metrics (Avg, Stddev, 95th) for a given prefix.\n",
    "    \n",
    "    Parameters:\n",
    "    - df: pandas DataFrame\n",
    "    - prefix: one of \"Freemium\", \"Premium\", \"Overall\"\n",
    "    - metrics: list of metric types to test (default = [\"Avg\", \"Stddev\", \"95th\"])\n",
    "    - value_suffix: usually \"Latency\"\n",
    "    \n",
    "    Returns:\n",
    "    - Combined DataFrame of results per config and overall\n",
    "    \"\"\"\n",
    "    results_all = []\n",
    "\n",
    "    # Ensure Config Label exists\n",
    "    if \"Config Label\" not in df.columns:\n",
    "        df[\"Config Label\"] = df[\"Terminals\"].astype(str) + \" (\" + df[\"PremiumClients\"].astype(str) + \":\" + df[\"FreemiumClients\"].astype(str) + \")\"\n",
    "\n",
    "    # Loop over each latency metric type\n",
    "    for metric in metrics:\n",
    "        colname = f\"{prefix} {metric} {value_suffix}\"\n",
    "        if colname not in df.columns:\n",
    "            print(f\"Skipping missing column: {colname}\")\n",
    "            continue\n",
    "        \n",
    "        grouped = df.groupby(\"Config Label\")[colname]\n",
    "        for config, values in grouped:\n",
    "            values = values.dropna()\n",
    "            if len(values) >= 3:\n",
    "                stat, p = shapiro(values)\n",
    "                results_all.append({\n",
    "                    \"Metric\": f\"{prefix} {metric} {value_suffix}\",\n",
    "                    \"Config\": config,\n",
    "                    \"N\": len(values),\n",
    "                    \"W-statistic\": stat,\n",
    "                    \"p-value\": p,\n",
    "                    \"Normal?\": \"Yes\" if p > 0.05 else \"No\"\n",
    "                })\n",
    "\n",
    "        # Global test on the entire dataset\n",
    "        global_vals = df[colname].dropna()\n",
    "        if len(global_vals) >= 3:\n",
    "            stat, p = shapiro(global_vals)\n",
    "            results_all.append({\n",
    "                \"Metric\": f\"{prefix} {metric} {value_suffix}\",\n",
    "                \"Config\": \"All Combined\",\n",
    "                \"N\": len(global_vals),\n",
    "                \"W-statistic\": stat,\n",
    "                \"p-value\": p,\n",
    "                \"Normal?\": \"Yes\" if p > 0.05 else \"No\"\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(results_all)\n",
    "    \n",
    "# For Premium metrics\n",
    "shapiro_premium = run_shapiro_tests(df, \"Premium\")\n",
    "display(shapiro_premium)\n",
    "# For Freemium metrics\n",
    "shapiro_freemium = run_shapiro_tests(df, \"Freemium\")\n",
    "display(shapiro_freemium)\n",
    "# For Overall metrics\n",
    "shapiro_overall = run_shapiro_tests(df, \"Overall\")\n",
    "display(shapiro_overall)"
   ]
  },
