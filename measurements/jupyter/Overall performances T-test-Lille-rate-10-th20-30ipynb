   "source": [
    "## Q2: Is freemium degradation bounded under PLB?\n",
    "We are analyzing how freemium users' latency changes as the number of premium clients increases — under the hypothesis that premium users get prioritized, so freemium performance should degrade.\n",
    "\n",
    "Each t-test asks:\n",
    ">\"Is the freemium latency under one premium load statistically significantly different from the latency under another premium load?\"\n",
    "\n",
    "We're using p-values to validate that performance degradation is real, not just a random fluctuation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "47fa224a-ff29-4554-afab-e79e2d14a28e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "from matplotlib.lines import Line2D\n",
    "import matplotlib.cm as cm\n",
    "import matplotlib.colors as colors\n",
    "\n",
    "def run_degradation_tests(df, metric_col, label=\"Freemium\"):\n",
    "    results = []\n",
    "    grouped = df.groupby(\"Terminals\")\n",
    "\n",
    "    for total_clients, group in grouped:\n",
    "        subgroups = group.groupby(\"PremiumClients\")\n",
    "\n",
    "        # Only test if there are at least 3 different Premium configurations\n",
    "        if len(subgroups) < 3:\n",
    "            continue\n",
    "\n",
    "        # Sort by PremiumClients count\n",
    "        sorted_premium = sorted(subgroups.groups.keys())\n",
    "\n",
    "        low_group = subgroups.get_group(sorted_premium[0])[metric_col].dropna()\n",
    "        mid_group = subgroups.get_group(sorted_premium[1])[metric_col].dropna()\n",
    "        high_group = subgroups.get_group(sorted_premium[2])[metric_col].dropna()\n",
    "\n",
    "        if len(low_group) > 2 and len(mid_group) > 2 and len(high_group) > 2:\n",
    "            stat1, pval1 = ttest_ind(low_group, mid_group, equal_var=False)\n",
    "            stat2, pval2 = ttest_ind(mid_group, high_group, equal_var=False)\n",
    "            stat3, pval3 = ttest_ind(low_group, high_group, equal_var=False)\n",
    "\n",
    "            results.append({\n",
    "                \"Total Clients\": total_clients,\n",
    "                \"Low Premium\": sorted_premium[0],\n",
    "                \"Mid Premium\": sorted_premium[1],\n",
    "                \"High Premium\": sorted_premium[2],\n",
    "                f\"{label} Mean (Low)\": low_group.mean(),\n",
    "                f\"{label} Mean (Mid)\": mid_group.mean(),\n",
    "                f\"{label} Mean (High)\": high_group.mean(),\n",
    "                \"p (Low vs Mid)\": pval1,\n",
    "                \"p (Mid vs High)\": pval2,\n",
    "                \"p (Low vs High)\": pval3\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "    \n",
    "## This function tests whether freemium latency increases as we increase the number of freemium users — for each total number of clients \n",
    "## This tells you whether adding more freemium users (under a fixed total) leads to significantly higher latency.\n",
    "\n",
    "def run_degradation_tests_freemium(df, metric_col, label=\"Freemium\"):\n",
    "    results = []\n",
    "    grouped = df.groupby(\"Terminals\")\n",
    "\n",
    "    for total_clients, group in grouped:\n",
    "        subgroups = group.groupby(\"FreemiumClients\")\n",
    "\n",
    "        # Only test if there are at least 3 different Premium configurations\n",
    "        if len(subgroups) < 3:\n",
    "            continue\n",
    "\n",
    "        # Sort by PremiumClients count\n",
    "        sorted_freemium = sorted(subgroups.groups.keys())\n",
    "\n",
    "        low_group = subgroups.get_group(sorted_freemium[0])[metric_col].dropna()\n",
    "        mid_group = subgroups.get_group(sorted_freemium[1])[metric_col].dropna()\n",
    "        high_group = subgroups.get_group(sorted_freemium[2])[metric_col].dropna()\n",
    "\n",
    "        if len(low_group) > 2 and len(mid_group) > 2 and len(high_group) > 2:\n",
    "            stat1, pval1 = ttest_ind(low_group, mid_group, equal_var=False)\n",
    "            stat2, pval2 = ttest_ind(mid_group, high_group, equal_var=False)\n",
    "            stat3, pval3 = ttest_ind(low_group, high_group, equal_var=False)\n",
    "\n",
    "            results.append({\n",
    "                \"Total Clients\": total_clients,\n",
    "                \"Low Freemium\": sorted_freemium[0],\n",
    "                \"Mid Freemium\": sorted_freemium[1],\n",
    "                \"High Freemium\": sorted_freemium[2],\n",
    "                f\"{label} Mean (Low)\": low_group.mean(),\n",
    "                f\"{label} Mean (Mid)\": mid_group.mean(),\n",
    "                f\"{label} Mean (High)\": high_group.mean(),\n",
    "                \"p (Low vs Mid)\": pval1,\n",
    "                \"p (Mid vs High)\": pval2,\n",
    "                \"p (Low vs High)\": pval3\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "def compute_degradation_slope(results_df, label_prefix):\n",
    "    slopes = []\n",
    "    for _, row in results_df.iterrows():\n",
    "        x = [row[\"Low Premium\"], row[\"Mid Premium\"], row[\"High Premium\"]]\n",
    "        y = [\n",
    "            row[f\"{label_prefix} Mean (Low)\"],\n",
    "            row[f\"{label_prefix} Mean (Mid)\"],\n",
    "            row[f\"{label_prefix} Mean (High)\"]\n",
    "        ]\n",
    "        # Compute simple linear slope (delta latency / delta premium count)\n",
    "        coeffs = np.polyfit(x, y, 1)  # degree 1 polynomial (line)\n",
    "        slopes.append(coeffs[0])  # slope\n",
    "    return slopes\n",
    "\n",
    "def plot_degradation_from_results(results_df, metric_prefix=\"Freemium\"):\n",
    "    melt_df = results_df.melt(\n",
    "        id_vars=[\"Total Clients\", \"Low Premium\", \"Mid Premium\", \"High Premium\"],\n",
    "        value_vars=[\n",
    "            f\"{metric_prefix} Mean (Low)\",\n",
    "            f\"{metric_prefix} Mean (Mid)\",\n",
    "            f\"{metric_prefix} Mean (High)\"\n",
    "        ],\n",
    "        var_name=\"Premium Level\",\n",
    "        value_name=\"Mean Latency\"\n",
    "    )\n",
    "\n",
    "    level_map = {\n",
    "        f\"{metric_prefix} Mean (Low)\": \"Low Premium\",\n",
    "        f\"{metric_prefix} Mean (Mid)\": \"Mid Premium\",\n",
    "        f\"{metric_prefix} Mean (High)\": \"High Premium\"\n",
    "    }\n",
    "\n",
    "    marker_map = {\n",
    "        f\"{metric_prefix} Mean (Low)\": \"o\",  # Circle\n",
    "        f\"{metric_prefix} Mean (Mid)\": \"s\",  # Square\n",
    "        f\"{metric_prefix} Mean (High)\": \"D\"  # Diamond\n",
    "    }\n",
    "\n",
    "    melt_df[\"PremiumClients\"] = melt_df.apply(lambda row: row[level_map[row[\"Premium Level\"]]], axis=1)\n",
    "    melt_df[\"Marker\"] = melt_df[\"Premium Level\"].map(marker_map)\n",
    "\n",
    "    # Initialize plot properly\n",
    "    fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "    # Create scatter plots for each premium level\n",
    "    for level in melt_df[\"Premium Level\"].unique():\n",
    "        subset = melt_df[melt_df[\"Premium Level\"] == level]\n",
    "        sns.scatterplot(\n",
    "            data=subset,\n",
    "            x=\"Total Clients\",\n",
    "            y=\"Mean Latency\",\n",
    "            hue=\"PremiumClients\",\n",
    "            palette=\"magma\",\n",
    "            style=\"Premium Level\",\n",
    "            markers=[marker_map[level]],\n",
    "            s=30,\n",
    "            edgecolor=\"black\",\n",
    "            linewidth=0.5,\n",
    "            ax=ax,\n",
    "            legend=False\n",
    "        )\n",
    "\n",
    "    ax.set_title(f\"{metric_prefix} Mean Latency vs Total Clients\")\n",
    "    ax.set_xlabel(\"Number of Total Clients\")\n",
    "    ax.set_ylabel(\"Mean Latency\")\n",
    "    ax.grid(True)\n",
    "\n",
    "    # Legend for Premium Level markers\n",
    "    handles_marker = [\n",
    "        Line2D([0], [0], marker='o', color='w', label='Low', markerfacecolor='gray', markeredgecolor='black'),\n",
    "        Line2D([0], [0], marker='s', color='w', label='Mid', markerfacecolor='gray', markeredgecolor='black'),\n",
    "        Line2D([0], [0], marker='D', color='w', label='High', markerfacecolor='gray', markeredgecolor='black')\n",
    "    ]\n",
    "    ax.legend(handles=handles_marker, title=\"Premium Level\", loc=\"lower left\", bbox_to_anchor=(1, 0.8))\n",
    "\n",
    "    # Colorbar\n",
    "    norm = colors.Normalize(vmin=melt_df[\"Total Clients\"].min(), vmax=melt_df[\"Total Clients\"].max())\n",
    "    sm = cm.ScalarMappable(norm=norm, cmap=\"magma\")\n",
    "    sm.set_array([])\n",
    "    cbar = fig.colorbar(sm, ax=ax, pad=0.05, shrink=0.5)\n",
    "    cbar.set_label(\"Total Clients\")\n",
    "\n",
    "    ax.set_xticks(sorted(melt_df[\"Total Clients\"].unique()))\n",
    "    fig.tight_layout()\n",
    "    plt.show()"
   ]
