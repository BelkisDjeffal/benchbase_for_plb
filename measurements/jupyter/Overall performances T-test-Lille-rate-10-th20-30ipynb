    "from scipy.stats import pearsonr\n",
    "import pandas as pd\n",
    "\n",
    "def run_latency_degradation_tests(df, latency_col):\n",
    "    \"\"\"\n",
    "    Tests whether the given latency column increases with total clients,\n",
    "    premium clients, and freemium clients.\n",
    "    Uses Pearson correlation and p-values.\n",
    "    \"\"\"\n",
    "    results = []\n",
    "\n",
    "    for feature in [\"Total Clients\", \"PremiumClients\", \"FreemiumClients\"]:\n",
    "        x = df[feature]\n",
    "        y = df[latency_col]\n",
    "        \n",
    "        # Ensure no NaNs\n",
    "        mask = x.notna() & y.notna()\n",
    "        x = x[mask]\n",
    "        y = y[mask]\n",
    "        \n",
    "        if len(x) >= 3:\n",
    "            corr, pval = pearsonr(x, y)\n",
    "            results.append({\n",
    "                \"Latency Type\": latency_col,\n",
    "                \"Feature\": feature,\n",
    "                \"Correlation\": corr,\n",
    "                \"p-value\": pval\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "    \n",
    "freemium_results = run_latency_degradation_tests(df, \"Freemium Avg Latency\")\n",
    "premium_results = run_latency_degradation_tests(df, \"Premium Avg Latency\")\n",
    "combined_results = pd.concat([freemium_results, premium_results])\n",
    "combined_results"
   ]
