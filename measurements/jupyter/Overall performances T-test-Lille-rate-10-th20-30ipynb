    "df[\"Terminals\"] = df.iloc[:, 4]\n",
    "\n",
    "metrics = [\"Throughput\", \"Goodput\", \"Latency\"]\n",
    "stats = [\"min\", \"25th\", \"median\", \"avg\", \"stddev\", \"75th\", \"90th\", \"95th\", \"99th\", \"max\"]\n",
    "\n",
    "for metric in metrics:\n",
    "    for stat in stats:\n",
    "        pattern = fr\"{stat}=([0-9]*\\.?[0-9]+)\"\n",
    "        df[f\"{metric} {stat}\"] = df[f\"{metric} Distribution\"].str.extract(pattern).astype(float)\n",
    "        df_rr[f\"{metric} {stat}\"] = df_rr[f\"{metric} Distribution\"].str.extract(pattern).astype(float)\n",
    "\n",
    "def plot_metric_stat_scatterplot_dual(df1, df2, metric, stat, label1=\"PLB\", label2=\"RR\"):\n",
    "    column = f\"{metric} {stat}\"\n",
    "    \n",
    "    df1_plot = df1[[\"Terminals\", column]].copy()\n",
    "    df1_plot[\"Strategy\"] = label1\n",
    "    \n",
    "    df2_plot = df2[[\"Terminals\", column]].copy()\n",
    "    df2_plot[\"Strategy\"] = label2\n",
    "\n",
    "    combined_df = pd.concat([df1_plot, df2_plot])\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=(14, 7))\n",
    "    sns.scatterplot(x='Terminals', y=column, hue='Strategy', data=combined_df, s=60, alpha=0.8)\n",
    "    plt.title(f\"{metric} {stat} vs Terminals (PLB vs RR)\")\n",
    "    plt.xlabel(\"Terminals\")\n",
    "    plt.ylabel(f\"{metric} {stat}\")\n",
    "    plt.grid(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def plot_metric_stat_boxplot_dual(df1, df2, metric, stat, label1=\"PLB\", label2=\"RR\"):\n",
