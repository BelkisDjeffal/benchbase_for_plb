    "    df2_plot[\"Strategy\"] = label2\n",
    "\n",
    "    combined_df = pd.concat([df1_plot, df2_plot])\n",
    "\n",
    "    plt.figure(figsize=(14, 7))\n",
    "    sns.boxplot(x='Terminals', y=column, hue='Strategy', data=combined_df, palette={label1: 'red', label2: 'green'})\n",
    "    plt.title(f\"{metric} {stat} vs Terminals (PLB vs RR)\")\n",
    "    plt.xlabel(\"Terminals\")\n",
